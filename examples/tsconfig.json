{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@astryxdesign/core/*": ["../packages/web/node_modules/@astryxdesign/core/dist/*"],
      "uraeda/page": ["../packages/web/src/extensions/hooks.ts"],
      "uraeda/server": ["../packages/server/src/extension-api.ts"],
      "*": ["../packages/web/node_modules/@types/*", "../packages/web/node_modules/*"]
    },
    "typeRoots": ["../packages/server/node_modules/@types"]
  },
  "include": ["."]
}
