# Copy to .env, which git ignores, to set the web UI's server up on this machine under `vp dev`.
# Each variable overrides the settings file, `~/.config/uraeda/config.toml`, for the run, and is
# never written into it; a flag overrides both. The npm package reads no `.env`: only its flags, its
# environment, and the settings file.

# Host names accepted besides 127.0.0.1 and localhost, separated by commas: your machine's full name
# on your tailnet, like `mac.tail1234.ts.net`, as `tailscale status --self` shows it. After
# `tailscale serve --bg 4310`, your phone opens https://mac.tail1234.ts.net/. The server listens on
# 127.0.0.1 only: http://<machine>:4310/ never reaches it. Every browser signs in with the access key
# the first start shows; a public address goes through a proxy that ends TLS on this machine, like
# Caddy or Tailscale Funnel, with its host name listed here. The settings file's `allowed_hosts`
# applies when this is empty, but Vite's own check under `vp dev` reads this variable only.
URAEDA_ALLOWED_HOSTS=

# The port of `vp dev` and the server: else the settings file's `port`, else 4310. `vp dev` reads
# this variable only.
URAEDA_PORT=

# The repository the UI opens first, added to the list of repositories: this one by default.
URAEDA_REPO=

# Where the agent runner keeps its cache, `runner.sqlite`: sessions, runs, and their logs, where the
# list of repositories, `repositories.json`, is kept, and the access key's hash and the signed-in
# devices, `sign-in.json`. By default, `$XDG_DATA_HOME/uraeda/` on
# Linux (`~/.local/share/uraeda/`), `~/Library/Application Support/uraeda/` on macOS, and
# `%APPDATA%\uraeda\` on Windows. `ura add` reads the environment only: set it there too, or the
# CLI and the server use two lists. A running server keeps the files that only live while it runs
# in its `run/` folder.
URAEDA_DATA_DIR=

# Where the settings file, `config.toml`, is kept: by default `$XDG_CONFIG_HOME/uraeda/`, or
# `~/.config/uraeda/` when `XDG_CONFIG_HOME` is unset, on Linux and macOS.
URAEDA_CONFIG_DIR=
