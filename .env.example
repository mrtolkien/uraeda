# Copy to .env, which git ignores, to set the web UI's server up on this machine.

# Host names accepted besides 127.0.0.1 and localhost, separated by commas: your machine's full name
# on your tailnet, like `mac.tail1234.ts.net`, as `tailscale status --self` shows it. After
# `tailscale serve --bg 4310`, your phone opens https://mac.tail1234.ts.net/. The server listens on
# 127.0.0.1 only: http://<machine>:4310/ never reaches it.
URAEDA_ALLOWED_HOSTS=

# The port of `vp dev` and the server, 4310 by default.
URAEDA_PORT=

# The repository the UI opens, this one by default.
URAEDA_REPO=

# Where the agent runner keeps its cache, `runner.sqlite`: sessions, runs, and their logs, and where
# the list of repositories, `repositories.json`, is kept. By default, `$XDG_DATA_HOME/uraeda/` on
# Linux (`~/.local/share/uraeda/`), `~/Library/Application Support/uraeda/` on macOS, and
# `%APPDATA%\uraeda\` on Windows. `ura add` reads the environment only: set it there too, or the
# CLI and the server use two lists.
URAEDA_DATA_DIR=
