{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mrtolkien/uraeda/main/schemas/theme.json",
  "title": "Uraeda colour theme",
  "description": "A colour theme of Uraeda's web UI, one TOML file per theme in the themes folder beside config.toml. See docs/web-ui.md, \"Colour themes\".",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "The name in the lists; the file's name without .toml when absent."
    },
    "mode": {
      "enum": ["dark", "light"],
      "description": "The list the theme shows in; taken from extends when absent."
    },
    "extends": {
      "type": "string",
      "description": "The id of the theme every role left out comes from, of the same mode; the default of its mode, Catppuccin Mocha or Latte, when absent."
    },
    "palette": {
      "type": "object",
      "description": "The theme's own colours, named freely, private to the file.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "A colour, #rrggbb or #rrggbbaa."
      }
    },
    "roles": {
      "type": "object",
      "description": "The meaning each colour takes: a palette name, of this file or of a theme it extends, or a colour. Every role is optional.",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "The ground behind everything."
        },
        "raised": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Popovers, code blocks, a pane's surface."
        },
        "sunken": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "A well below the page."
        },
        "chip": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "A neutral filled mark: a grey badge, a skeleton."
        },
        "cursor-row": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "The row under the cursor, or picked."
        },
        "marked": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "The block selected in a review, and its edge."
        },
        "rule": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Panes' borders, dividers, fields."
        },
        "pane-title": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "A pane's title in its border."
        },
        "ink": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Body text."
        },
        "ink-quiet": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "What reads second: counts, help, labels."
        },
        "ink-faint": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Disabled and faint text."
        },
        "action": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "What can be pressed: a button, focus, the active pane, the next step."
        },
        "on-action": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Text on a filled action or status."
        },
        "needs-you": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "The Needs-you pane, Home's count, since-marks, key caps."
        },
        "changed": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Changed since you read it."
        },
        "added": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "New, added, done, success, the repository's mark."
        },
        "removed": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Wrong, removed, failed."
        },
        "caution": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Warning, waiting."
        },
        "context": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Context notes."
        },
        "yours": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Your own messages in a session."
        },
        "link": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Links."
        },
        "working": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "A running session's mark."
        },
        "live": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "A live window's double border and title."
        },
        "example": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "An example pane."
        },
        "sub-agent": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "A sub-agent's mark."
        },
        "heading-1": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Level 1 headings."
        },
        "heading-2": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Level 2 headings."
        },
        "heading-3": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Level 3 headings, and deeper levels."
        },
        "code-inline": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Inline code in markdown."
        },
        "quote": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "A markdown quote."
        },
        "mode-normal": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "The status line's Vim mode: Normal."
        },
        "mode-insert": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "The status line's Vim mode: Insert."
        },
        "mode-visual": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "The status line's Vim mode: Visual."
        },
        "mode-replace": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "The status line's Vim mode: Replace."
        },
        "mode-command": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "The status line's Vim mode: Command."
        },
        "code-ground": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's background."
        },
        "syntax-keyword": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: keywords."
        },
        "syntax-string": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: strings."
        },
        "syntax-comment": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: comments."
        },
        "syntax-number": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: numbers."
        },
        "syntax-constant": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: constants."
        },
        "syntax-function": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: functions."
        },
        "syntax-type": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: types."
        },
        "syntax-operator": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: operators."
        },
        "syntax-property": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: propertys."
        },
        "syntax-punctuation": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: punctuation."
        },
        "syntax-tag": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: tags."
        },
        "syntax-attribute": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: attributes."
        },
        "syntax-variable": {
          "type": "string",
          "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[^#].*)$",
          "description": "Code's tokens: variables."
        }
      }
    }
  }
}
