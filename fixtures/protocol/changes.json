[
  {
    "name": "a text that grew",
    "old": { "title": "Reply", "text": "Hello" },
    "new": { "title": "Reply", "text": "Hello, world" },
    "ops": [{ "op": "append", "path": ["text"], "text": ", world" }]
  },
  {
    "name": "a text that changed",
    "old": { "text": "Hello" },
    "new": { "text": "Help" },
    "ops": [{ "op": "set", "path": ["text"], "value": "Help" }]
  },
  {
    "name": "a reply that grows inside a list",
    "old": { "items": [{ "id": "m1", "text": "Hi" }, { "id": "m2", "text": "Wor" }] },
    "new": { "items": [{ "id": "m1", "text": "Hi" }, { "id": "m2", "text": "World" }] },
    "ops": [{ "op": "append", "path": ["items", "m2", "text"], "text": "ld" }]
  },
  {
    "name": "a list with an insert",
    "old": { "rows": [{ "id": "a" }, { "id": "c" }] },
    "new": { "rows": [{ "id": "a" }, { "id": "b", "title": "New" }, { "id": "c" }] },
    "ops": [
      { "op": "insert", "path": ["rows"], "value": { "id": "b", "title": "New" }, "before": "c" }
    ]
  },
  {
    "name": "a list with an insert at its end",
    "old": { "rows": [{ "id": "a" }] },
    "new": { "rows": [{ "id": "a" }, { "id": "b" }] },
    "ops": [{ "op": "insert", "path": ["rows"], "value": { "id": "b" } }]
  },
  {
    "name": "a list with a removal",
    "old": { "rows": [{ "id": "a" }, { "id": "b" }, { "id": "c" }] },
    "new": { "rows": [{ "id": "a" }, { "id": "c" }] },
    "ops": [{ "op": "remove", "path": ["rows", "b"] }]
  },
  {
    "name": "a list with a move to its start",
    "old": { "rows": [{ "id": "a" }, { "id": "b" }, { "id": "c" }, { "id": "d" }] },
    "new": { "rows": [{ "id": "d" }, { "id": "a" }, { "id": "b" }, { "id": "c" }] },
    "ops": [{ "op": "move", "path": ["rows", "d"], "before": "a" }]
  },
  {
    "name": "a list with a move to its end",
    "old": { "rows": [{ "id": "a" }, { "id": "b" }, { "id": "c" }] },
    "new": { "rows": [{ "id": "b" }, { "id": "c" }, { "id": "a" }] },
    "ops": [{ "op": "move", "path": ["rows", "a"] }]
  },
  {
    "name": "a list with a removal, a move, an insert, and a changed item",
    "old": {
      "rows": [
        { "id": "a", "status": "idle" },
        { "id": "b", "status": "idle" },
        { "id": "c", "status": "idle" }
      ]
    },
    "new": {
      "rows": [
        { "id": "c", "status": "working" },
        { "id": "d", "status": "idle" },
        { "id": "a", "status": "idle" }
      ]
    },
    "ops": [
      { "op": "remove", "path": ["rows", "b"] },
      { "op": "insert", "path": ["rows"], "value": { "id": "d", "status": "idle" }, "before": "a" },
      { "op": "move", "path": ["rows", "c"], "before": "d" },
      { "op": "set", "path": ["rows", "c", "status"], "value": "working" }
    ]
  },
  {
    "name": "a nested record",
    "old": { "title": "Protocol", "step": { "name": "spec", "progress": null } },
    "new": { "title": "Protocol", "step": { "name": "tasks", "progress": { "done": 1, "total": 4 } } },
    "ops": [
      { "op": "set", "path": ["step", "name"], "value": "tasks" },
      { "op": "set", "path": ["step", "progress"], "value": { "done": 1, "total": 4 } }
    ]
  },
  {
    "name": "a field that went, and one that came",
    "old": { "title": "Protocol", "review": "open" },
    "new": { "title": "Protocol", "committed": true },
    "ops": [
      { "op": "remove", "path": ["review"] },
      { "op": "set", "path": ["committed"], "value": true }
    ]
  },
  {
    "name": "a list whose items have no id",
    "old": { "turns": ["1", "2"] },
    "new": { "turns": ["1", "2", "3"] },
    "ops": [{ "op": "set", "path": ["turns"], "value": ["1", "2", "3"] }]
  },
  {
    "name": "a list that was empty",
    "old": { "rows": [] },
    "new": { "rows": [{ "id": "a" }, { "id": "b" }] },
    "ops": [{ "op": "set", "path": ["rows"], "value": [{ "id": "a" }, { "id": "b" }] }]
  },
  {
    "name": "a list where two items share an id",
    "old": { "rows": [{ "id": "a" }, { "id": "b" }] },
    "new": { "rows": [{ "id": "a" }, { "id": "a" }] },
    "ops": [{ "op": "set", "path": ["rows"], "value": [{ "id": "a" }, { "id": "a" }] }]
  },
  {
    "name": "a value of another kind",
    "old": { "missing": true },
    "new": [{ "id": "a" }],
    "ops": [{ "op": "set", "path": [], "value": [{ "id": "a" }] }]
  },
  {
    "name": "nothing changed",
    "old": { "rows": [{ "id": "a" }] },
    "new": { "rows": [{ "id": "a" }] },
    "ops": []
  }
]
