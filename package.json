{
  "name": "uraeda-workspace",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "node packages/server/scripts/dev.ts",
    "start": "vp run --filter uraeda-binding build && vp run --filter uraeda-web build && node packages/server/src/main.ts",
    "release": "node packages/uraeda/scripts/bump.ts",
    "validate:claude": "node packages/server/scripts/validate-claude.ts"
  },
  "devDependencies": {
    "@nkzw/eslint-plugin": "catalog:",
    "@nkzw/oxlint-config": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-no-only-tests": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
