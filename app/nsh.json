{
  "name": "Uraeda",
  "id": "dev.uraeda.app",
  "version": "0.0.0",
  "build": 1,
  "minRuntime": "0.5.0",
  "rust": "../crates/app",
  "theme": "theme.json",
  "icon": { "web": "web/icon.png" },
  "web": { "base": "/", "history": false },
  "ios": {
    "infoPlist": {
      "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
      "NSLocalNetworkUsageDescription": "Uraeda connects to its server when you run it on a computer of your own network."
    }
  },
  "capabilities": {
    "network": {
      "hosts": ["*"]
    },
    "webview": {
      "hosts": ["*"]
    },
    "clipboard": true,
    "statusBar": true,
    "picker": true,
    "fs": { "read": ["${homeDir}", "/tmp"] },
    "openUrl": true,
    "host": ["uraeda.*"],
    "process": {
      "env": ["URAEDA_SANDBOX", "URAEDA_ROUTE"]
    }
  }
}
