#!/bin/sh
# Uraeda's app, as the package starts it: the tarball's `uraeda`, and the AppImage's `AppRun`.
# It checks the program loads on this machine, and says in words what to install when it does not,
# then starts it. The program is `lib/uraeda`, beside `lib/ura` and the app's files, `lib/nsh/`.
here=$(dirname "$(readlink -f "$0")")
app="$here/lib/uraeda"

# A library missing, or one too old for a call the program links, stops it as it loads, before
# `main`: the loader says so in its own words, which are turned into what to install.
if ! loaded=$("$app" --version 2>&1); then
  echo "Uraeda cannot start on this machine:" >&2
  case "$loaded" in
    *"loading shared libraries: libwebkitgtk-6.0"* | *"loading shared libraries: libjavascriptcoregtk-6.0"*)
      need="WebKitGTK 6.0" ;;
    # Every other library it links is GTK's or one GTK brings: Pango, cairo, HarfBuzz, GLib.
    *"loading shared libraries: "*) need="GTK 4, version 4.14 or newer, and WebKitGTK 6.0" ;;
    *"undefined symbol: gtk_"* | *"undefined symbol: gdk_"* | *"undefined symbol: gsk_"*)
      need="GTK 4.14 or newer: this machine's GTK is older" ;;
    *) need="" ;;
  esac
  if [ -n "$need" ]; then
    cat >&2 <<EOF
  It needs $need.
  Debian and Ubuntu: sudo apt install libgtk-4-1 libwebkitgtk-6.0-4
  Fedora: sudo dnf install gtk4 webkitgtk6.0
  Arch: sudo pacman -S gtk4 webkitgtk-6.0
  GTK 4.14 came with Ubuntu 24.04, Debian 13, and Fedora 40.
EOF
  fi
  echo "The system said: $loaded" >&2
  exit 1
fi

exec "$app" "$@"
