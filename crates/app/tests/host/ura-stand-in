#!/bin/sh
# A stand-in of `ura`, for the tests of the app's start of its server (`stand_in.rs`): a server
# that is slow to start, one that never answers, and one that ignores its stop.
#
# It adds its process to the file `$STAND_IN_STARTS`, a line each start, waits until the file
# `$STAND_IN_GATE` exists, then becomes `$STAND_IN_URA` with its own arguments, the real
# `ura serve`, in the same process. A gate that never opens is a server that never answers.
# With `$STAND_IN_DEAF` set it ignores SIGTERM, as a server that hangs while it stops.
if [ -n "${STAND_IN_DEAF:-}" ]; then
  trap '' TERM
fi
echo "$$" >>"$STAND_IN_STARTS"
while [ ! -e "$STAND_IN_GATE" ]; do
  sleep 0.02
done
exec "$STAND_IN_URA" "$@"
