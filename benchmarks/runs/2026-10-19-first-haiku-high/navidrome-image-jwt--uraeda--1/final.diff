@@ -0,0 +1,105 @@
+package artwork_test
+
+import (
+	"encoding/base64"
+
+	"github.com/go-chi/jwtauth/v5"
+	"github.com/navidrome/navidrome/core/artwork"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("Public artwork tokens", func() {
+	artID := model.NewArtworkID(model.KindArtistArtwork, "1234")
+
+	BeforeEach(func() {
+		auth.TokenAuth = jwtauth.New("HS256", []byte("test secret"), nil)
+	})
+
+	sign := func(key *jwtauth.JWTAuth, claims map[string]any) string {
+		_, token, err := key.Encode(claims)
+		Expect(err).ToNot(HaveOccurred())
+		return token
+	}
+
+	It("round-trips an artwork ID", func() {
+		decoded, err := artwork.DecodeArtworkID(artwork.EncodeArtworkID(artID))
+
+		Expect(err).ToNot(HaveOccurred())
+		Expect(decoded).To(Equal(artID))
+	})
+
+	It("carries only the id claim", func() {
+		claims, err := auth.Validate(artwork.EncodeArtworkID(artID))
+
+		Expect(err).ToNot(HaveOccurred())
+		Expect(claims).To(HaveKeyWithValue("id", "ar-1234"))
+		Expect(claims).ToNot(HaveKey("size"))
+	})
+
+	DescribeTable("reports invalid JWT for a token that does not verify",
+		func(token string) {
+			_, err := artwork.DecodeArtworkID(token)
+
+			Expect(err).To(MatchError("invalid JWT"))
+		},
+		Entry("an empty token", ""),
+		Entry("a malformed token", "xx-123"),
+	)
+
+	It("rejects a token signed with another key", func() {
+		token := sign(jwtauth.New("HS256", []byte("other secret"), nil), map[string]any{"id": "ar-1234"})
+
+		_, err := artwork.DecodeArtworkID(token)
+
+		Expect(err).To(MatchError("invalid JWT"))
+	})
+
+	It("rejects an unsigned token", func() {
+		header := base64.RawURLEncoding.EncodeToString([]byte(`{"alg":"none","typ":"JWT"}`))
+		payload := base64.RawURLEncoding.EncodeToString([]byte(`{"id":"ar-1234"}`))
+
+		_, err := artwork.DecodeArtworkID(header + "." + payload + ".")
+
+		Expect(err).To(MatchError("invalid JWT"))
+	})
+
+	DescribeTable("reports invalid artwork id for an id that does not parse",
+		func(id string) {
+			_, err := artwork.DecodeArtworkID(sign(auth.TokenAuth, map[string]any{"id": id}))
+
+			Expect(err).To(MatchError("invalid artwork id"))
+		},
+		Entry("an unknown kind", "xx-1234"),
+		Entry("an empty ID after the kind", "ar-"),
+		Entry("no kind", "1234"),
+		Entry("an empty id", ""),
+	)
+
+	It("reports invalid artwork id for the token of an empty artwork ID", func() {
+		_, err := artwork.DecodeArtworkID(artwork.EncodeArtworkID(model.ArtworkID{}))
+
+		Expect(err).To(MatchError("invalid artwork id"))
+	})
+
+	It("rejects a token with no id claim", func() {
+		_, err := artwork.DecodeArtworkID(sign(auth.TokenAuth, map[string]any{"size": 0}))
+
+		Expect(err).To(MatchError("missing id claim"))
+	})
+
+	It("rejects an id claim that is not a string", func() {
+		_, err := artwork.DecodeArtworkID(sign(auth.TokenAuth, map[string]any{"id": 1234}))
+
+		Expect(err).To(MatchError("invalid id claim type"))
+	})
+
+	It("decodes an old token with a size claim", func() {
+		decoded, err := artwork.DecodeArtworkID(sign(auth.TokenAuth, map[string]any{"id": "ar-1234", "size": 300}))
+
+		Expect(err).ToNot(HaveOccurred())
+		Expect(decoded).To(Equal(artID))
+	})
+})
