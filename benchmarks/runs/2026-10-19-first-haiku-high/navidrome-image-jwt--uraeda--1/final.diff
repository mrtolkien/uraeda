+	"github.com/navidrome/navidrome/tests"
+	"github.com/navidrome/navidrome/utils/number"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("Resizing public images", func() {
+	solid := func(w, h int) image.Image {
+		return image.NewRGBA(image.Rect(0, 0, w, h))
+	}
+	encodePNG := func(w, h int) []byte {
+		var buf bytes.Buffer
+		Expect(png.Encode(&buf, solid(w, h))).To(Succeed())
+		return buf.Bytes()
+	}
+	encodeJPEG := func(w, h int) []byte {
+		var buf bytes.Buffer
+		Expect(jpeg.Encode(&buf, solid(w, h), nil)).To(Succeed())
+		return buf.Bytes()
+	}
+	resize := func(src []byte, size int) []byte {
+		r, _, err := resizeImage(bytes.NewReader(src), size)
+		Expect(err).ToNot(HaveOccurred())
+		out, err := io.ReadAll(r)
+		Expect(err).ToNot(HaveOccurred())
+		return out
+	}
+	decode := func(r io.Reader) (string, image.Point) {
+		img, format, err := image.Decode(r)
+		Expect(err).ToNot(HaveOccurred())
+		return format, img.Bounds().Size()
+	}
+
+	It("resizes a 16 by 16 PNG to 15 by 15 and keeps the PNG format", func() {
+		format, bounds := decode(bytes.NewReader(resize(encodePNG(16, 16), 15)))
+
+		Expect(format).To(Equal("png"))
+		Expect(bounds).To(Equal(image.Pt(15, 15)))
+	})
+
+	It("keeps the proportions of a wide PNG", func() {
+		format, bounds := decode(bytes.NewReader(resize(encodePNG(1200, 600), 300)))
+
+		Expect(format).To(Equal("png"))
+		Expect(bounds).To(Equal(image.Pt(300, 150)))
+	})
+
+	It("resizes the longer side of a tall PNG", func() {
+		_, bounds := decode(bytes.NewReader(resize(encodePNG(600, 1200), 300)))
+
+		Expect(bounds).To(Equal(image.Pt(150, 300)))
+	})
+
+	It("keeps a JPEG as a JPEG", func() {
+		format, bounds := decode(bytes.NewReader(resize(encodeJPEG(1200, 600), 300)))
+
+		Expect(format).To(Equal("jpeg"))
+		Expect(bounds).To(Equal(image.Pt(300, 150)))
+	})
+
+	It("resizes to the 1000 pixel limit", func() {
+		_, bounds := decode(bytes.NewReader(resize(encodePNG(1200, 600), 1000)))
+
+		Expect(bounds).To(Equal(image.Pt(1000, 500)))
+	})
+
+	It("gives each size from 1 to 1000 as its longer side", func() {
+		src := encodePNG(40, 20)
+		for size := 1; size <= 1000; size++ {
+			_, bounds := decode(bytes.NewReader(resize(src, size)))
+			Expect(number.Max(bounds.X, bounds.Y)).To(Equal(size), "size %d", size)
+		}
+	})
+
+	Context("through the artwork service", func() {
+		var aw *artwork
+
+		BeforeEach(func() {
+			DeferCleanup(configtest.SetupConfig())
+			conf.Server.ImageCacheSize = "0" // Disable cache
+			conf.Server.CoverArtPriority = "front.png, index.html"
+
+			ds := &tests.MockDataStore{MockedTranscoding: &tests.MockTranscodingRepo{}}
+			ds.Album(context.Background()).(*tests.MockAlbumRepo).SetData(model.Albums{
+				{ID: "444", Name: "Only external", ImageFiles: "tests/fixtures/front.png"},
+				{ID: "777", Name: "Not an image", ImageFiles: "tests/fixtures/index.html"},
+			})
+			aw = NewArtwork(ds, GetImageCache(), tests.NewMockFFmpeg("")).(*artwork)
+		})
+
+		It("resizes the 16 by 16 front.png to 15 by 15 as a PNG", func() {
+			r, _, err := aw.Get(context.Background(), "al-444", 15)
+			Expect(err).ToNot(HaveOccurred())
+			defer r.Close()
+
+			format, bounds := decode(r)
+
+			Expect(format).To(Equal("png"))
+			Expect(bounds).To(Equal(image.Pt(15, 15)))
+		})
+
+		It("serves an undecodable cover as stored at a size", func() {
+			stored, err := os.ReadFile("tests/fixtures/index.html")
+			Expect(err).ToNot(HaveOccurred())
+
+			r, _, err := aw.Get(context.Background(), "al-777", 300)
+			Expect(err).ToNot(HaveOccurred())
+			defer r.Close()
+
+			Expect(io.ReadAll(r)).To(Equal(stored))
+		})
+	})
+})
