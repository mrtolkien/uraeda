+		Expect(rec.Body.Bytes()).To(Equal(widePNG))
+	})
+
+	It("keeps a JPEG as a JPEG", func() {
+		rec := get(artwork.EncodeArtworkID(model.MustParseArtworkID("al-999")), "size=300")
+
+		Expect(rec.Code).To(Equal(http.StatusOK))
+		format, bounds := decode(rec.Body.Bytes())
+		Expect(format).To(Equal("jpeg"))
+		Expect(bounds).To(Equal(image.Pt(300, 150)))
+	})
+
+	It("serves an undecodable cover as stored at a size", func() {
+		rec := get(artwork.EncodeArtworkID(model.MustParseArtworkID("al-777")), "size=300")
+
+		Expect(rec.Code).To(Equal(http.StatusOK))
+		Expect(rec.Body.Bytes()).To(Equal(storedIndex))
+	})
+})
