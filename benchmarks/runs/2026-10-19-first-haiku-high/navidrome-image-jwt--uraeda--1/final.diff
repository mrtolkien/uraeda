@@ -0,0 +1,202 @@
+package public_test
+
+import (
+	"bytes"
+	"context"
+	"image"
+	"image/jpeg"
+	"image/png"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+
+	"github.com/go-chi/jwtauth/v5"
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/conf/configtest"
+	"github.com/navidrome/navidrome/core/artwork"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/server/public"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("Public image links", func() {
+	var router *public.Router
+	var storedFront, storedIndex, widePNG, wideJPEG []byte
+
+	solid := func(w, h int) image.Image {
+		return image.NewRGBA(image.Rect(0, 0, w, h))
+	}
+
+	// BeforeEach writes a 1200 by 600 PNG and JPEG to a temporary folder, and points albums at them
+	BeforeEach(func() {
+		DeferCleanup(configtest.SetupConfig())
+		conf.Server.ImageCacheSize = "0" // Disable cache
+		conf.Server.CoverArtPriority = "front.png, cover.jpg, index.html"
+		auth.TokenAuth = jwtauth.New("HS256", []byte("test secret"), nil)
+
+		var pngBuf, jpegBuf bytes.Buffer
+		Expect(png.Encode(&pngBuf, solid(1200, 600))).To(Succeed())
+		Expect(jpeg.Encode(&jpegBuf, solid(1200, 600), nil)).To(Succeed())
+		widePNG, wideJPEG = pngBuf.Bytes(), jpegBuf.Bytes()
+
+		dir := GinkgoT().TempDir()
+		Expect(os.WriteFile(filepath.Join(dir, "front.png"), widePNG, 0600)).To(Succeed())
+		Expect(os.WriteFile(filepath.Join(dir, "cover.jpg"), wideJPEG, 0600)).To(Succeed())
+		storedFront, _ = os.ReadFile("tests/fixtures/front.png")
+		storedIndex, _ = os.ReadFile("tests/fixtures/index.html")
+
+		ds := &tests.MockDataStore{MockedTranscoding: &tests.MockTranscodingRepo{}}
+		ds.Album(context.Background()).(*tests.MockAlbumRepo).SetData(model.Albums{
+			{ID: "444", Name: "Only external", ImageFiles: "tests/fixtures/front.png"},
+			{ID: "777", Name: "Not an image", ImageFiles: "tests/fixtures/index.html"},
+			{ID: "888", Name: "Wide PNG", ImageFiles: filepath.Join(dir, "front.png")},
+			{ID: "999", Name: "Wide JPEG", ImageFiles: filepath.Join(dir, "cover.jpg")},
+		})
+		router = public.New(artwork.NewArtwork(ds, artwork.GetImageCache(), tests.NewMockFFmpeg("")))
+	})
+
+	// get serves /img/<token>, with the query as given
+	get := func(token, query string) *httptest.ResponseRecorder {
+		rec := httptest.NewRecorder()
+		router.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/img/"+token+"?"+query, nil))
+		return rec
+	}
+	// signed makes a token with the given claims, as a link issued before this change may have
+	signed := func(claims map[string]any) string {
+		token, err := auth.CreatePublicToken(claims)
+		Expect(err).ToNot(HaveOccurred())
+		return token
+	}
+	// decode reads the format and the bounds of an image served by the route
+	decode := func(body []byte) (string, image.Point) {
+		img, format, err := image.Decode(bytes.NewReader(body))
+		Expect(err).ToNot(HaveOccurred())
+		return format, img.Bounds().Size()
+	}
+
+	It("serves the stored bytes when no size is given", func() {
+		rec := get(artwork.EncodeArtworkID(model.MustParseArtworkID("al-444")), "")
+
+		Expect(rec.Code).To(Equal(http.StatusOK))
+		Expect(rec.Body.Bytes()).To(Equal(storedFront))
+	})
+
+	It("serves the original for a token issued with a size claim", func() {
+		rec := get(signed(map[string]any{"id": "al-444", "size": 300}), "")
+
+		Expect(rec.Code).To(Equal(http.StatusOK))
+		Expect(rec.Body.Bytes()).To(Equal(storedFront))
+	})
+
+	It("answers 404 Not Found for a token signed with another key", func() {
+		_, token, err := jwtauth.New("HS256", []byte("other secret"), nil).Encode(map[string]any{"id": "al-444"})
+		Expect(err).ToNot(HaveOccurred())
+
+		rec := get(token, "")
+
+		Expect(rec.Code).To(Equal(http.StatusNotFound))
+		Expect(rec.Body.String()).To(ContainSubstring("Not Found"))
+	})
+
+	DescribeTable("answers 404 for a token whose id is missing or unusable",
+		func(claims map[string]any) {
+			rec := get(signed(claims), "")
+
+			Expect(rec.Code).To(Equal(http.StatusNotFound))
+		},
+		Entry("with no id claim", map[string]any{"size": 300}),
+		Entry("with an id claim that is not a string", map[string]any{"id": 1234}),
+		Entry("with an id that is not an artwork ID", map[string]any{"id": "xx-1234"}),
+	)
+
+	It("answers 404 Artwork not found for a valid token whose artwork is gone", func() {
+		rec := get(artwork.EncodeArtworkID(model.MustParseArtworkID("al-9999")), "")
+
+		Expect(rec.Code).To(Equal(http.StatusNotFound))
+		Expect(rec.Body.String()).To(ContainSubstring("Artwork not found"))
+	})
+
+	It("resizes a 16 by 16 PNG to 15 by 15", func() {
+		rec := get(artwork.EncodeArtworkID(model.MustParseArtworkID("al-444")), "size=15")
+
+		Expect(rec.Code).To(Equal(http.StatusOK))
+		format, bounds := decode(rec.Body.Bytes())
+		Expect(format).To(Equal("png"))
+		Expect(bounds).To(Equal(image.Pt(15, 15)))
+	})
+
+	It("enlarges a 16 by 16 PNG to size 300", func() {
+		rec := get(artwork.EncodeArtworkID(model.MustParseArtworkID("al-444")), "size=300")
+
+		Expect(rec.Code).To(Equal(http.StatusOK))
+		_, bounds := decode(rec.Body.Bytes())
+		Expect(bounds).To(Equal(image.Pt(300, 300)))
+	})
+
+	It("resizes the longer side of a wide PNG", func() {
+		rec := get(artwork.EncodeArtworkID(model.MustParseArtworkID("al-888")), "size=300")
+
+		Expect(rec.Code).To(Equal(http.StatusOK))
+		format, bounds := decode(rec.Body.Bytes())
+		Expect(format).To(Equal("png"))
+		Expect(bounds).To(Equal(image.Pt(300, 150)))
+	})
+
+	It("resizes to the 1000 pixel limit", func() {
+		rec := get(artwork.EncodeArtworkID(model.MustParseArtworkID("al-888")), "size=1000")
+
+		Expect(rec.Code).To(Equal(http.StatusOK))
+		_, bounds := decode(rec.Body.Bytes())
+		Expect(bounds).To(Equal(image.Pt(1000, 500)))
+	})
+
+	It("serves the original for a size above 1000", func() {
+		rec := get(artwork.EncodeArtworkID(model.MustParseArtworkID("al-888")), "size=1001")
+
+		Expect(rec.Code).To(Equal(http.StatusOK))
+		Expect(rec.Body.Bytes()).To(Equal(widePNG))
+	})
+
+	DescribeTable("serves the original for a size that is not a positive whole number",
+		func(size string) {
+			rec := get(artwork.EncodeArtworkID(model.MustParseArtworkID("al-888")), "size="+size)
+
+			Expect(rec.Code).To(Equal(http.StatusOK))
+			Expect(rec.Body.Bytes()).To(Equal(widePNG))
+		},
