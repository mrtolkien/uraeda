@@ -24,3 +99,83 @@ def get_aspects():
     response = requests.get(TBBO_URL + '/api/aspects')
 
     return response.text
+
+
+class Observations(object):
+
+    @classmethod
+    def _find_type(cls, type_id):
+        for obs_type in OBSERVATION_TYPES:
+            if obs_type['id'] == type_id:
+                return obs_type
+        return None
+
+    @classmethod
+    def get_key_value_pair(cls, type_id, value_id):
+        """Resolve a type id and value id to (label, value name), or None if unknown."""
+        obs_type = cls._find_type(type_id)
+        if obs_type is None:
+            return None
+        for value in obs_type['values']:
+            if value['id'] == value_id:
+                return KeyValuePair(obs_type['label'], value['name'])
+        return None
+
+    @classmethod
+    def _resolve_ids(cls, label, value_name):
+        """Return the (type_id, value_id) for a type label and value name."""
+        for obs_type in OBSERVATION_TYPES:
+            if obs_type['label'] != label:
+                continue
+            for value in obs_type['values']:
+                if value['name'] == value_name:
+                    return obs_type['id'], value['id']
+            raise ValueError(f'Unknown value {value_name!r} for observation {label!r}')
+        raise ValueError(f'Unknown observation {label!r}')
+
+    @classmethod
+    def persist_observations(cls, username, work_id, observations):
+        """Make the patron's stored observations for the work match `observations`.
+
+        `observations` is a list of single-entry {label: value_name} dicts.
+        """
+        submitted = set()
+        for observation in observations:
+            for label, value_name in observation.items():
+                submitted.add(cls._resolve_ids(label, value_name))
+
+        oldb = db.get_db()
+        with oldb.transaction():
+            stored = {
+                (row['type'], row['value'])
+                for row in cls.get_patron_observations(username, work_id)
+            }
+            where = 'username = $username AND work_id = $work_id'
+            for type_id, value_id in stored - submitted:
+                oldb.delete(
+                    'observations',
+                    where=where + ' AND observation_type = $type_id AND observation_value = $value_id',
+                    vars={'username': username, 'work_id': work_id, 'type_id': type_id, 'value_id': value_id},
+                )
+            for type_id, value_id in submitted - stored:
+                oldb.insert(
+                    'observations',
+                    username=username,
+                    work_id=work_id,
+                    observation_type=type_id,
+                    observation_value=value_id,
+                )
+
+    @classmethod
+    def get_patron_observations(cls, username, work_id):
+        """Return the patron's stored observations for the work.
+
+        Each record supports `record['type']` (observation type id) and
+        `record['value']` (observation value id).
+        """
+        oldb = db.get_db()
+        query = (
+            'SELECT observation_type AS type, observation_value AS value '
+            'FROM observations WHERE username = $username AND work_id = $work_id'
+        )
+        return list(oldb.query(query, vars={'username': username, 'work_id': work_id}))
