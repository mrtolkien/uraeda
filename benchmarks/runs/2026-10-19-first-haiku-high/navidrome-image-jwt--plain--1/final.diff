 	return artReader, err
 }
 
-func PublicLink(artID model.ArtworkID, size int) string {
+// EncodeArtworkID returns a public token that identifies the artwork. Only the artwork ID is included in the token,
+// image size is not part of it and must be passed separately (e.g. as a query parameter)
+func EncodeArtworkID(artID model.ArtworkID) string {
 	token, _ := auth.CreatePublicToken(map[string]any{
-		"id":   artID.String(),
-		"size": size,
+		"id": artID.String(),
 	})
 	return token
 }
+
+// DecodeArtworkID verifies a public token created by EncodeArtworkID and returns the artwork ID it contains
+func DecodeArtworkID(tokenString string) (model.ArtworkID, error) {
+	claims, err := auth.Validate(tokenString)
+	if err != nil {
+		return model.ArtworkID{}, errors.New("invalid JWT")
+	}
+	idClaim, ok := claims["id"]
+	if !ok {
+		return model.ArtworkID{}, errors.New("missing id claim in JWT")
+	}
+	id, ok := idClaim.(string)
+	if !ok {
+		return model.ArtworkID{}, errors.New("invalid id type in JWT")
+	}
+	return model.ParseArtworkID(id)
+}
diff --git a/core/artwork/artwork_public_token_test.go b/core/artwork/artwork_public_token_test.go
new file mode 100644
index 00000000..ccf6bf7c
--- /dev/null
+++ b/core/artwork/artwork_public_token_test.go
@@ -0,0 +1,39 @@
+package artwork
+
+import (
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("Public artwork tokens", func() {
+	BeforeEach(func() {
+		auth.Init(&tests.MockDataStore{})
+	})
+
+	It("round-trips an artwork ID", func() {
+		artID := model.NewArtworkID(model.KindArtistArtwork, "1234")
+		token := EncodeArtworkID(artID)
+		Expect(DecodeArtworkID(token)).To(Equal(artID))
+	})
+
+	It("returns an error for an invalid token", func() {
+		_, err := DecodeArtworkID("xx-123")
+		Expect(err).To(MatchError("invalid JWT"))
+	})
+
+	It("returns an error for an empty artwork ID", func() {
+		token := EncodeArtworkID(model.ArtworkID{})
+		_, err := DecodeArtworkID(token)
+		Expect(err).To(MatchError("invalid artwork id"))
+	})
+
+	It("returns an error when the id claim is missing", func() {
+		token, err := auth.CreatePublicToken(map[string]any{"size": 100})
+		Expect(err).ToNot(HaveOccurred())
+		_, err = DecodeArtworkID(token)
+		Expect(err).To(HaveOccurred())
+	})
+})
