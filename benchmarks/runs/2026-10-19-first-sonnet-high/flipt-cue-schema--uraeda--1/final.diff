diff --git a/internal/config/schema_test.go b/internal/config/schema_test.go
new file mode 100644
index 00000000..27c5a6e1
--- /dev/null
+++ b/internal/config/schema_test.go
@@ -0,0 +1,256 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"testing"
+	"time"
+
+	"cuelang.org/go/cue"
+	"cuelang.org/go/cue/cuecontext"
+	"github.com/mitchellh/mapstructure"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestSchemaToolingAssumptions checks the outside behaviour the schema test relies on:
+// decode hooks run when a struct becomes a map, and CUE rejects unknown fields.
+func TestSchemaToolingAssumptions(t *testing.T) {
+	type inner struct {
+		Name string `mapstructure:"name"`
+	}
+	type sample struct {
+		TTL    time.Duration `mapstructure:"ttl"`
+		Inner  inner         `mapstructure:"inner"`
+		Absent string        `mapstructure:"absent,omitempty"`
+	}
+
+	var m map[string]any
+	dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		DecodeHook: mapstructure.ComposeDecodeHookFunc(DecodeHooks...),
+		Result:     &m,
+	})
+	require.NoError(t, err)
+	require.NoError(t, dec.Decode(sample{TTL: time.Minute, Inner: inner{Name: "x"}}))
+
+	assert.Equal(t, time.Minute, m["ttl"])
+	assert.Equal(t, map[string]any{"name": "x"}, m["inner"])
+	assert.NotContains(t, m, "absent")
+
+	ctx := cuecontext.New()
+	schema, err := compileSchema(ctx)
+	require.NoError(t, err)
+
+	v := schema.Unify(ctx.Encode(map[string]any{"unknown_section": 1}))
+	assert.Error(t, v.Validate(cue.Concrete(true)))
+}
+
+func compileSchema(ctx *cue.Context) (cue.Value, error) {
+	insts := ctx.CompileBytes(mustReadFile("../../config/flipt.schema.cue"))
+	if err := insts.Err(); err != nil {
+		return cue.Value{}, err
+	}
+	return insts.LookupPath(cue.ParsePath("#FliptSpec")), nil
+}
+
+func mustReadFile(path string) []byte {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		panic(err)
+	}
+	return b
+}
+
+// decodeDefault decodes DefaultConfig into a map with the loading decode hooks.
+func decodeDefault(t *testing.T) map[string]any {
+	t.Helper()
+
+	var m map[string]any
+	dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		DecodeHook: mapstructure.ComposeDecodeHookFunc(DecodeHooks...),
+		Result:     &m,
+	})
+	require.NoError(t, err)
+	require.NoError(t, dec.Decode(DefaultConfig()))
+
+	return m
+}
+
+func TestDefaultConfigTopLevelKeys(t *testing.T) {
+	m := decodeDefault(t)
+
+	assert.NotContains(t, m, "Version")
+	allowed := []string{"version", "log", "ui", "cors", "cache", "server", "tracing", "db", "meta", "authentication", "audit", "experimental", "storage"}
+	for key := range m {
+		assert.Contains(t, allowed, key)
+	}
+
+	db, ok := m["db"].(map[string]any)
+	require.True(t, ok)
+	assert.Equal(t, "file:/var/opt/flipt/flipt.db", db["url"])
+	assert.NotContains(t, db, "protocol")
+}
+
+func TestDefaultConfigStorageOmitted(t *testing.T) {
+	storage, ok := decodeDefault(t)["storage"].(map[string]any)
+	require.True(t, ok)
+	assert.NotContains(t, storage, "local")
+	assert.NotContains(t, storage, "git")
+}
+
+// toSchemaMap decodes cfg to a map, and converts durations and enums to the
+// strings the schema describes.
+func toSchemaMap(t *testing.T, cfg *Config) map[string]any {
+	t.Helper()
+
+	var m map[string]any
+	dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		DecodeHook: mapstructure.ComposeDecodeHookFunc(DecodeHooks...),
+		Result:     &m,
+	})
+	require.NoError(t, err)
+	require.NoError(t, dec.Decode(cfg))
+
+	return stringify(m).(map[string]any)
+}
+
+func stringify(v any) any {
+	switch v := v.(type) {
+	case map[string]any:
+		for k, e := range v {
+			v[k] = stringify(e)
+		}
+		return v
+	case []string:
+		return v
+	case fmt.Stringer:
+		return v.String()
+	default:
+		return v
+	}
+}
+
+func validateSchema(t *testing.T, m map[string]any) error {
+	t.Helper()
+
+	ctx := cuecontext.New()
+	schema, err := compileSchema(ctx)
+	require.NoError(t, err)
+
+	return schema.Unify(ctx.Encode(m)).Validate(cue.Concrete(true))
+}
+
+func TestDefaultConfigValidatesAgainstSchema(t *testing.T) {
+	assert.NoError(t, validateSchema(t, toSchemaMap(t, DefaultConfig())))
+}
+
+func TestDefaultConfigDurations(t *testing.T) {
+	cfg := DefaultConfig()
+	assert.Equal(t, time.Minute, decodeDefault(t)["cache"].(map[string]any)["ttl"])
+
+	m := toSchemaMap(t, cfg)
+	section := func(names ...string) map[string]any {
+		cur := m
+		for _, n := range names {
+			cur = cur[n].(map[string]any)
+		}
+		return cur
+	}
+
+	assert.Equal(t, "24h0m0s", section("authentication", "session")["token_lifetime"])
+	assert.Equal(t, "10m0s", section("authentication", "session")["state_lifetime"])
+	assert.Equal(t, "1m0s", section("cache")["ttl"])
+	assert.Equal(t, "5m0s", section("cache", "memory")["eviction_interval"])
+	assert.Equal(t, "2m0s", section("audit", "buffer")["flush_period"])
+}
+
+func TestSchemaRejectsUnknownSection(t *testing.T) {
+	m := toSchemaMap(t, DefaultConfig())
+	m["unknown_section"] = map[string]any{}
+
+	assert.Error(t, validateSchema(t, m))
+}
+
+func TestSchemaAcceptsShapes(t *testing.T) {
+	gitStorage := func(m map[string]any, git map[string]any) {
+		m["storage"] = map[string]any{"type": "git", "git": git}
+	}
+	parts := func(m map[string]any, extra map[string]any) {
+		db := map[string]any{"protocol": "postgres", "host": "localhost", "name": "flipt"}
+		for k, v := range extra {
+			db[k] = v
+		}
+		m["db"] = db
+	}
+
+	tests := []struct {
+		name    string
+		mutate  func(m map[string]any)
+		wantErr bool
+	}{
+		{"postgres url with duration lifetime", func(m map[string]any) {
+			m["db"] = map[string]any{"url": "postgres://postgres@localhost:5432/flipt?sslmode=disable", "conn_max_lifetime": "30m0s"}
+		}, false},
+		{"database parts form", func(m map[string]any) {
+			parts(m, map[string]any{"port": 5432, "user": "flipt"})
+		}, false},
+		{"database parts form without port and user", func(m map[string]any) {
+			parts(m, nil)
+		}, true},
+		{"cors origins as string", func(m map[string]any) {
+			m["cors"] = map[string]any{"allowed_origins": "foo.com"}
+		}, false},
+		{"cors origins as list", func(m map[string]any) {
+			m["cors"] = map[string]any{"allowed_origins": []string{"foo.com", "bar.com"}}
+		}, false},
+		{"git with basic authentication", func(m map[string]any) {
+			gitStorage(m, map[string]any{
+				"repository": "https://github.com/flipt-io/flipt.git", "ref": "production", "poll_interval": "5s",
+				"authentication": map[string]any{"basic": map[string]any{"username": "user", "password": "pass"}},
+			})
+		}, false},
+		{"git with token authentication", func(m map[string]any) {
+			gitStorage(m, map[string]any{
+				"repository": "https://github.com/flipt-io/flipt.git", "ref": "production", "poll_interval": "5s",
+				"authentication": map[string]any{"token": map[string]any{"access_token": "abc"}},
+			})
+		}, false},
+		{"git without authentication", func(m map[string]any) {
+			gitStorage(m, map[string]any{"repository": "https://github.com/flipt-io/flipt.git", "ref": "main", "poll_interval": "30s"})
+		}, false},
+		{"local storage", func(m map[string]any) {
+			m["storage"] = map[string]any{"type": "local", "local": map[string]any{"path": "."}}
+		}, false},
+		{"flush period with fraction", func(m map[string]any) {
+			m["audit"] = map[string]any{"buffer": map[string]any{"flush_period": "1.5s"}}
+		}, false},
+		{"flush period as integer", func(m map[string]any) {
+			m["audit"] = map[string]any{"buffer": map[string]any{"flush_period": 120}}
+		}, false},
+		{"flush period not a duration", func(m map[string]any) {
+			m["audit"] = map[string]any{"buffer": map[string]any{"flush_period": "soon"}}
+		}, true},
+		{"token bootstrap without expiration", func(m map[string]any) {
+			m["authentication"] = map[string]any{"methods": map[string]any{"token": map[string]any{
+				"bootstrap": map[string]any{"token": "abc"}}}}
+		}, false},
+		{"kubernetes method", func(m map[string]any) {
+			m["authentication"] = map[string]any{"methods": map[string]any{"kubernetes": map[string]any{
+				"enabled": true, "discovery_url": "https://kubernetes.default.svc"}}}
+		}, false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			m := toSchemaMap(t, DefaultConfig())
+			tt.mutate(m)
+
+			err := validateSchema(t, m)
+			if tt.wantErr {
+				assert.Error(t, err)
+				return
+			}
+			assert.NoError(t, err)
+		})
+	}
+}
