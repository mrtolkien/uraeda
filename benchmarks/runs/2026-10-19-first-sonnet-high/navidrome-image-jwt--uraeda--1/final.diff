+
+		decoded, err := artwork.DecodeArtworkID(token)
+
+		Expect(err).ToNot(HaveOccurred())
+		Expect(decoded).To(Equal(model.NewArtworkID(model.KindArtistArtwork, "1234")))
+	})
+})
