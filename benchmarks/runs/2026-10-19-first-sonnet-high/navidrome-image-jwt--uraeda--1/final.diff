diff --git a/server/public/public_endpoints_test.go b/server/public/public_endpoints_test.go
new file mode 100644
index 00000000..e7d4e0ef
--- /dev/null
+++ b/server/public/public_endpoints_test.go
@@ -0,0 +1,95 @@
+package public_test
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"time"
+
+	"github.com/navidrome/navidrome/core/artwork"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/server/public"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+type fakeArtwork struct {
+	id   string
+	size int
+	call bool
+}
+
+func (f *fakeArtwork) Get(_ context.Context, id string, size int) (io.ReadCloser, time.Time, error) {
+	f.id, f.size, f.call = id, size, true
+	return io.NopCloser(strings.NewReader("image")), time.Now(), nil
+}
+
+var _ = Describe("/img/{jwt}", func() {
+	var aw *fakeArtwork
+	var router *public.Router
+
+	BeforeEach(func() {
+		auth.Init(&tests.MockDataStore{})
+		aw = &fakeArtwork{}
+		router = public.New(aw)
+	})
+
+	get := func(token, query string) *httptest.ResponseRecorder {
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/img/"+token+query, nil))
+		return w
+	}
+	artistToken := func() string {
+		return artwork.EncodeArtworkID(model.NewArtworkID(model.KindArtistArtwork, "1234"))
+	}
+
+	It("passes the size query parameter", func() {
+		w := get(artistToken(), "?size=200")
+
+		Expect(w.Code).To(Equal(http.StatusOK))
+		Expect(aw.id).To(Equal("ar-1234"))
+		Expect(aw.size).To(Equal(200))
+	})
+
+	It("serves the original when no size is sent", func() {
+		w := get(artistToken(), "")
+
+		Expect(w.Code).To(Equal(http.StatusOK))
+		Expect(aw.size).To(Equal(0))
+	})
+
+	It("ignores the size claim of an old token", func() {
+		token, _ := auth.CreatePublicToken(map[string]any{"id": "ar-1234", "size": 300})
+
+		w := get(token, "")
+
+		Expect(w.Code).To(Equal(http.StatusOK))
+		Expect(aw.size).To(Equal(0))
+	})
+
+	It("treats a non-numeric size as 0", func() {
+		get(artistToken(), "?size=abc")
+
+		Expect(aw.size).To(Equal(0))
+	})
+
+	It("answers 404 for a token that fails to decode", func() {
+		w := get("xx-123", "")
+
+		Expect(w.Code).To(Equal(http.StatusNotFound))
+		Expect(aw.call).To(BeFalse())
+	})
+
+	It("answers 404 for a token whose id is not a string", func() {
+		token, _ := auth.CreatePublicToken(map[string]any{"id": 5})
+
+		w := get(token, "")
+
+		Expect(w.Code).To(Equal(http.StatusNotFound))
+		Expect(aw.call).To(BeFalse())
+	})
+})
