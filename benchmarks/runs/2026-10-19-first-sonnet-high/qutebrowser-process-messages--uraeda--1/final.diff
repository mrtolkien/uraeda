+@pytest.mark.posix
+def test_exit_sigterm(qtbot, proc, message_mock, py_proc):
+    with qtbot.wait_signal(proc.finished, timeout=10000):
+        proc.start(*py_proc("""
+            import os, signal
+            os.kill(os.getpid(), signal.SIGTERM)
+        """))
+
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert proc.outcome.code == 15
+    assert str(proc.outcome) == 'Testprocess terminated with status 15 (SIGTERM).'
+    assert proc.outcome.state_str() == 'terminated'
+    assert not proc.outcome.was_successful()
+
+
+def test_outcome_unknown_signal():
+    outcome = guiprocess.ProcessOutcome(
+        what='testprocess', status=QProcess.ExitStatus.CrashExit, code=4242)
+    assert str(outcome) == 'Testprocess crashed with status 4242.'
+    assert outcome.state_str() == 'crashed'
+
+
+@pytest.mark.posix
+def test_exit_sigterm_quiet(qtbot, proc, message_mock, py_proc):
+    with qtbot.wait_signal(proc.finished, timeout=10000):
+        proc.start(*py_proc("""
+            import os, signal
+            os.kill(os.getpid(), signal.SIGTERM)
+        """))
+
+    assert not message_mock.messages
+
+
+@pytest.mark.posix
+def test_exit_sigterm_verbose(qtbot, proc, message_mock, py_proc):
+    proc.verbose = True
+    with qtbot.wait_signal(proc.finished, timeout=10000):
+        proc.start(*py_proc("""
+            import os, signal
+            os.kill(os.getpid(), signal.SIGTERM)
+        """))
+
+    assert not [m for m in message_mock.messages
+                if m.level == usertypes.MessageLevel.error]
+    msg = message_mock.messages[-1]
+    assert msg.level == usertypes.MessageLevel.info
+    assert msg.text == (
+        f"Testprocess terminated with status 15 (SIGTERM). "
+        f"See :process {proc.pid} for details.")
+
+
+@pytest.mark.posix
+def test_exit_sigterm_output(qtbot, proc, message_mock, py_proc, caplog):
+    proc._output_messages = True
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc("""
+                import os, signal, sys
+                print("oops", file=sys.stderr, flush=True)
+                os.kill(os.getpid(), signal.SIGTERM)
+            """))
+
+    assert {m.text for m in message_mock.messages} == {'oops'}
+    assert not [m for m in caplog.messages if m.startswith('Process std')]
+
+
