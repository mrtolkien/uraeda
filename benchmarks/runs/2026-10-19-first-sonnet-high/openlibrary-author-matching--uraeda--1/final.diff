+    a missing date or a date without a year never matches.
+
+    :param dict a: Author dict {"name": "Some One", "birth_date": "1960", "death_date": "2020"}
+    :param dict b: Author dict, as a
+    """
+    for k in ['birth_date', 'death_date']:
+        m1 = re_year.search(a.get(k) or '')
+        m2 = re_year.search(b.get(k) or '')
+        if not m1 or not m2 or m1.group(1) != m2.group(1):
+            return False
+    return True
