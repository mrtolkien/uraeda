+def _save_author(mock_site, num, name, birth=None, death=None, alternate=None):
+    author = {
+        'key': f'/authors/OL{num}A',
+        'type': {'key': '/type/author'},
+        'name': name,
+    }
+    if birth:
+        author['birth_date'] = birth
+    if death:
+        author['death_date'] = death
+    if alternate:
+        author['alternate_names'] = alternate
+    mock_site.save(author)
+
+
+def _found(author):
+    """The key of the author find_entity returns, or None."""
+    found = find_entity(author)
+    return found.key if found else None
+
+
+class TestFindEntity:
+    def test_name_ignores_case(self, mock_site):
+        _save_author(mock_site, 1, 'Jane Austen', '1775', '1817')
+        author = {'name': 'jane austen', 'birth_date': '1775', 'death_date': '1817'}
+        assert _found(author) == '/authors/OL1A'
+
+    def test_exact_years_outrank_lower_key(self, mock_site):
+        _save_author(mock_site, 3, 'John Smith', '1950', '20')
+        _save_author(mock_site, 7, 'John Smith', '1950', '2010')
+        author = {'name': 'John Smith', 'birth_date': '1950', 'death_date': '2010'}
+        assert _found(author) == '/authors/OL7A'
+
+    def test_name_alone_when_dates_missing(self, mock_site):
+        _save_author(mock_site, 1, 'Jane Austen', '1775', '1817')
+        assert _found({'name': 'Jane Austen'}) == '/authors/OL1A'
+        assert _found({'name': 'Jane Austen', 'birth_date': '1775'}) == '/authors/OL1A'
+
+    def test_wildcard_takes_lowest_numeric_key(self, mock_site):
+        _save_author(mock_site, 10, 'John Smith')
+        _save_author(mock_site, 2, 'John Doe')
+        assert _found({'name': 'John*'}) == '/authors/OL2A'
+
+    def test_nothing_found(self, mock_site):
+        _save_author(mock_site, 2, 'John Doe')
+        assert _found({'name': 'Zed*'}) is None
+        reply = import_author({'name': 'Zed*'})
+        assert reply['name'] == 'Zed*'
+
+    def test_flipped_name(self, mock_site):
+        _save_author(mock_site, 1, 'John Smith', '1900', '1980')
+        author = {'name': 'Smith, John', 'birth_date': '1900', 'death_date': '1980'}
+        assert _found(author) == '/authors/OL1A'
+
