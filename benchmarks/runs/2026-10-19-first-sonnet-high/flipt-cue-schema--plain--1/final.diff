diff --git a/internal/config/schema_test.go b/internal/config/schema_test.go
new file mode 100644
index 00000000..224ff2e3
--- /dev/null
+++ b/internal/config/schema_test.go
@@ -0,0 +1,45 @@
+package config
+
+import (
+	"os"
+	"time"
+
+	"testing"
+
+	"cuelang.org/go/cue"
+	"cuelang.org/go/cue/cuecontext"
+	"github.com/mitchellh/mapstructure"
+	"github.com/stretchr/testify/require"
+)
+
+func adaptDurations(v any) any {
+	switch t := v.(type) {
+	case time.Duration:
+		return t.String()
+	case map[string]any:
+		for k, e := range t {
+			t[k] = adaptDurations(e)
+		}
+	}
+	return v
+}
+
+func TestDefaultConfigCUE(t *testing.T) {
+	res := map[string]any{}
+	dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		DecodeHook: mapstructure.ComposeDecodeHookFunc(DecodeHooks...),
+		Result:     &res,
+	})
+	require.NoError(t, err)
+	require.NoError(t, dec.Decode(DefaultConfig()))
+	adaptDurations(res)
+
+	b, err := os.ReadFile("../../config/flipt.schema.cue")
+	require.NoError(t, err)
+	ctx := cuecontext.New()
+	spec := ctx.CompileBytes(b).LookupPath(cue.ParsePath("#FliptSpec"))
+	v := ctx.CompileBytes(b)
+	require.NoError(t, v.Err())
+	require.NoError(t, spec.Err())
+	require.NoError(t, spec.Unify(ctx.Encode(res)).Validate(cue.Concrete(true)))
+}
