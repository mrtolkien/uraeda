 """Module for handling patron observation functionality"""
 
+from collections import namedtuple
+
 import requests
 
 from infogami import config
 from openlibrary import accounts
-from . import cache
+from . import cache, db
 
 # URL for TheBestBookOn
 TBBO_URL = config.get('tbbo_url')
 
+KeyValuePair = namedtuple('KeyValuePair', 'key value')
+
+
+def _values(*names):
+    """Numbers value names from 1, the value ids stored in the database."""
+    return [{'id': i, 'name': name} for i, name in enumerate(names, 1)]
+
+
+# The only home of observation type and value ids. Stored rows keep these
+# ids, so an id must never change meaning. `order` lists value ids in display order.
+OBSERVATIONS = [
+    {
+        'id': 1,
+        'label': 'pace',
+        'description': 'How fast the story moves',
+        'multi_choice': False,
+        'order': [1, 2, 3],
+        'values': _values('slow', 'medium', 'fast'),
+    },
+    {
+        'id': 2,
+        'label': 'fictionality',
+        'description': 'Whether the book is made up or true',
+        'multi_choice': False,
+        'order': [1, 2, 3],
+        'values': _values('nonfiction', 'fiction', 'biography'),
+    },
+    {
+        'id': 10,
+        'label': 'genres',
+        'description': 'The kinds of story the book tells',
+        'multi_choice': True,
+        'order': [1, 2, 3, 4, 5, 6, 7, 8, 9],
+        'values': _values(
+            'adventure', 'comedy', 'fantasy', 'historical', 'horror',
+            'romance', 'mystery', 'science fiction', 'thriller'),
+    },
+]
+
+
+def _sort_values(order_list, values_list):
+    """Returns the names of the values whose id is in `order_list`, in that
+    order. An id with no value is absorbed, a value whose id is not in the
+    order is excluded, and a repeated id counts once, the first of each winning.
+    """
+    names = {}
+    for value in values_list:
+        names.setdefault(value['id'], value['name'])
+
+    ordered = []
+    seen = set()
+    for value_id in order_list:
+        if value_id in names and value_id not in seen:
+            seen.add(value_id)
+            ordered.append(names[value_id])
+    return ordered
+
+
+def get_observations():
+    """Returns the observation types with their value names in display order."""
+    return {
+        'observations': [
+            {
+                'label': o['label'],
+                'description': o['description'],
+                'multi_choice': o['multi_choice'],
+                'values': _sort_values(o['order'], o['values']),
+            }
+            for o in OBSERVATIONS
+        ]
+    }
+
+
+class Observations(object):
+
+    @classmethod
+    def get_key_value_pair(cls, type_id, value_id):
+        """Returns the label of an observation type and the name of one of its
+        values as a `KeyValuePair`, or None if either id is not in the catalog.
+        """
+        for observation in OBSERVATIONS:
+            if observation['id'] != type_id:
+                continue
+            for value in observation['values']:
+                if value['id'] == value_id:
+                    return KeyValuePair(observation['label'], value['name'])
+        return None
+
+    @classmethod
+    def _to_ids(cls, observations):
+        """Maps submitted `{label: value_name}` dicts to a set of
+        (type id, value id), raising ValueError for an unknown label or name.
+        """
+        ids = set()
+        for observation in observations:
+            for label, name in observation.items():
+                type_ = next((o for o in OBSERVATIONS if o['label'] == label), None)
+                if type_ is None:
+                    raise ValueError('Unknown observation type: %r' % label)
+                value = next((v for v in type_['values'] if v['name'] == name), None)
+                if value is None:
+                    raise ValueError('Unknown value %r for observation %r' % (name, label))
+                ids.add((type_['id'], value['id']))
+        return ids
+
+    @classmethod
+    def persist_observations(cls, username, work_id, observations):
+        """Makes the patron's stored observations of the work equal to
+        `observations`, a list of single-entry `{label: value_name}` dicts.
+        Other works and other patrons are untouched.
+        """
+        submitted = cls._to_ids(observations)
+        oldb = db.get_db()
+        key = {'username': username, 'work_id': work_id}
+
+        with oldb.transaction():
+            stored = {(r['type'], r['value'])
+                      for r in cls.get_patron_observations(username, work_id)}
+
+            for type_id, value_id in stored - submitted:
+                oldb.delete(
+                    'observations',
+                    where=('username=$username AND work_id=$work_id AND '
+                           'observation_type=$observation_type AND '
+                           'observation_value=$observation_value'),
+                    vars=dict(key, observation_type=type_id, observation_value=value_id))
+
+            new_rows = [dict(key, observation_type=type_id, observation_value=value_id)
+                        for type_id, value_id in sorted(submitted - stored)]
+            if new_rows:
+                oldb.multiple_insert('observations', new_rows)
+
+    @classmethod
+    def get_patron_observations(cls, username, work_id):
+        """Returns the patron's stored observations of the work as records with
+        `type` and `value`, the ids of the observation type and of its value.
+        """
+        oldb = db.get_db()
+        query = (
+            "SELECT observation_type AS type, observation_value AS value "
+            "FROM observations WHERE username=$username AND work_id=$work_id")
+        return list(oldb.query(query, vars={'username': username, 'work_id': work_id}))
+
