+from contextlib import contextmanager
+
+import pytest
+
+from openlibrary.core import observations
+from openlibrary.core.observations import Observations
+
+VALUES = [{'id': 1, 'name': 'a'}, {'id': 2, 'name': 'b'}, {'id': 3, 'name': 'c'}]
+
+
+def _entry(label):
+    entries = observations.get_observations()['observations']
+    return next(e for e in entries if e['label'] == label)
+
+
+def test_sort_values_follows_order_list():
+    assert observations._sort_values([3, 1, 2], VALUES) == ['c', 'a', 'b']
+
+
+def test_sort_values_absorbs_missing_value():
+    assert observations._sort_values([2, 9, 1], VALUES) == ['b', 'a']
+
+
+def test_sort_values_excludes_unordered():
+    assert observations._sort_values([1], VALUES) == ['a']
+
+
+def test_sort_values_repeated_id_counts_once():
+    values = [{'id': 1, 'name': 'a'}, {'id': 1, 'name': 'z'}]
+    assert observations._sort_values([1, 1], values) == ['a']
+
+
+def test_get_observations_entries_have_the_expected_keys():
+    entries = observations.get_observations()['observations']
+
+    assert entries
+    for entry in entries:
+        assert set(entry) >= {'label', 'description', 'multi_choice', 'values'}
+
+
+def test_pace_values_in_order():
+    pace = _entry('pace')
+
+    assert pace['multi_choice'] is False
+    assert pace['values'] == ['slow', 'medium', 'fast']
+
+
+def test_fictionality_values_in_order():
+    assert _entry('fictionality')['values'] == ['nonfiction', 'fiction', 'biography']
+
+
+def test_get_key_value_pair():
+    pair = Observations.get_key_value_pair(1, 1)
+    assert (pair.key, pair.value) == ('pace', 'slow')
+
+    pair = Observations.get_key_value_pair(10, 7)
+    assert (pair.key, pair.value) == ('genres', 'mystery')
+
+
+def test_get_key_value_pair_unpacks():
+    key, value = Observations.get_key_value_pair(1, 1)
+
+    assert (key, value) == ('pace', 'slow')
+
+
+def test_get_key_value_pair_unknown_returns_none():
+    assert Observations.get_key_value_pair(99, 1) is None
+    assert Observations.get_key_value_pair(1, 99) is None
+
+
+class FakeDB(object):
+    """An in-memory `observations` table. Like Postgres, it casts `work_id` to
+    an integer, and it refuses a second row with the same four fields."""
+
+    def __init__(self):
+        self.rows = []
+        self.transactions = 0
+        self.inserted = []
+
+    def seed(self, username, work_id, pairs):
+        for type_id, value_id in pairs:
+            self.rows.append({
+                'username': username, 'work_id': work_id,
+                'observation_type': type_id, 'observation_value': value_id})
+
+    def rows_of(self, username, work_id):
+        return {(r['observation_type'], r['observation_value'])
+                for r in self.rows
+                if r['username'] == username and r['work_id'] == work_id}
+
+    @contextmanager
+    def transaction(self):
+        self.transactions += 1
+        yield
+
+    def query(self, sql, vars=None):
+        return [{'type': r['observation_type'], 'value': r['observation_value']}
+                for r in self.rows
+                if r['username'] == vars['username']
+                and r['work_id'] == int(vars['work_id'])]
+
+    def delete(self, table, where, vars=None):
+        match = {'username': vars['username'], 'work_id': int(vars['work_id']),
+                 'observation_type': vars['observation_type'],
+                 'observation_value': vars['observation_value']}
+        self.rows = [r for r in self.rows if r != match]
+
+    def multiple_insert(self, table, values):
+        for row in values:
+            assert set(row) == {'username', 'work_id', 'observation_type', 'observation_value'}
+            row = dict(row, work_id=int(row['work_id']))
+            assert row not in self.rows, 'primary key violated'
+            self.inserted.append(row)
+            self.rows.append(row)
+
+
+@pytest.fixture
+def fake_db(monkeypatch):
+    db = FakeDB()
+    monkeypatch.setattr(observations.db, 'get_db', lambda: db)
+    return db
+
+
+def test_persist_inserts_new_rows(fake_db):
+    Observations.persist_observations('mek', '123', [{'pace': 'slow'}, {'genres': 'mystery'}])
+
+    assert fake_db.rows_of('mek', 123) == {(1, 1), (10, 7)}
+    assert all(r['username'] == 'mek' and r['work_id'] == 123 for r in fake_db.inserted)
+
+
+def test_persist_replaces_stored_set(fake_db):
+    fake_db.seed('mek', 123, [(1, 1), (10, 7)])
+
+    Observations.persist_observations('mek', '123', [{'pace': 'slow'}, {'fictionality': 'fiction'}])
+
+    assert fake_db.rows_of('mek', 123) == {(1, 1), (2, 2)}
+    assert [(r['observation_type'], r['observation_value']) for r in fake_db.inserted] == [(2, 2)]
+
+
+def test_persist_empty_removes_all(fake_db):
+    fake_db.seed('mek', 123, [(1, 1)])
+
+    Observations.persist_observations('mek', '123', [])
+
+    assert fake_db.rows_of('mek', 123) == set()
+
+
+def test_persist_leaves_other_works_and_patrons(fake_db):
+    fake_db.seed('someone', 123, [(1, 2)])
+    fake_db.seed('mek', 456, [(1, 3)])
+    fake_db.seed('mek', 123, [(1, 1)])
+
+    Observations.persist_observations('mek', '123', [{'genres': 'comedy'}])
+
+    assert fake_db.rows_of('someone', 123) == {(1, 2)}
+    assert fake_db.rows_of('mek', 456) == {(1, 3)}
+    assert fake_db.rows_of('mek', 123) == {(10, 2)}
+
+
+def test_get_patron_observations_records(fake_db):
+    fake_db.seed('mek', 123, [(1, 1)])
+
+    records = Observations.get_patron_observations('mek', '123')
+
+    assert [(r['type'], r['value']) for r in records] == [(1, 1)]
+
+
+@pytest.mark.parametrize('submission', [
+    [{'pace': 'slow'}, {'speed': 'fast'}],
+    [{'speed': 'fast'}, {'pace': 'slow'}],
+    [{'pace': 'sluggish'}],
+])
+def test_persist_unknown_label_or_value_changes_nothing(fake_db, submission):
+    fake_db.seed('mek', 123, [(10, 7)])
+
+    with pytest.raises(ValueError):
+        Observations.persist_observations('mek', '123', submission)
+
+    assert fake_db.rows_of('mek', 123) == {(10, 7)}
+    assert fake_db.transactions == 0
+
+
+def test_persist_two_single_choice_values_stored(fake_db):
+    Observations.persist_observations('mek', '123', [{'pace': 'slow'}, {'pace': 'fast'}])
+
+    assert fake_db.rows_of('mek', 123) == {(1, 1), (1, 3)}
+
+
+def test_persist_duplicate_submission_stores_once(fake_db):
+    Observations.persist_observations('mek', '123', [{'pace': 'slow'}, {'pace': 'slow'}])
+
+    assert len(fake_db.rows) == 1
