+# Reverse lookup: label -> {'id': type_id, 'values': {value_name: value_id}}
+LABEL_LOOKUP = {
+    t['label']: {
+        'id': t['id'],
+        'values': {v['name']: v['id'] for v in t['values']},
+    }
+    for t in ID_LOOKUP.values()
+}
+
+
+def _sort_values(order_list, values_list):
+    """
+    Returns the `name` of each value in `values_list` whose `id` appears in
+    `order_list`, arranged according to `order_list`.  Ids in `order_list`
+    without a matching value are skipped; values whose id is not in
+    `order_list` are excluded.
+    """
+    names_by_id = {v['id']: v['name'] for v in values_list}
+    return [names_by_id[i] for i in order_list if i in names_by_id]
+
+
+def get_observations():
+    """
+    Returns a dictionary of observation types, each with its value names in
+    display order.
+    """
+    return {
+        'observations': [
+            {
+                'label': t['label'],
+                'description': t['description'],
+                'multi_choice': t['multi_choice'],
+                'values': _sort_values(t['order'], t['values']),
+            }
+            for t in ID_LOOKUP.values()
+        ]
+    }
+
+
+class Observations(object):
+
+    TABLENAME = 'observations'
+
+    @classmethod
+    def get_key_value_pair(cls, type_id, value_id):
+        """
+        Resolves an observation type id and value id to an
+        ObservationKeyValue(key=type_label, value=value_name).
+        """
+        observation = ID_LOOKUP[type_id]
+        for v in observation['values']:
+            if v['id'] == value_id:
+                return ObservationKeyValue(observation['label'], v['name'])
+        raise KeyError(
+            'Unknown value id %s for observation type %s' % (value_id, type_id))
+
+    @classmethod
+    def get_patron_observations(cls, username, work_id):
+        """
+        Returns a list of a patron's observations for a work.  Each record
+        has a `type` (observation type id) and `value` (value id).
+        """
+        oldb = db.get_db()
+        data = {'username': username, 'work_id': work_id}
+        query = (
+            "SELECT observation_type AS type, observation_value AS value "
+            "FROM observations "
+            "WHERE username=$username AND work_id=$work_id"
+        )
+        return list(oldb.query(query, vars=data))
+
+    @classmethod
+    def persist_observations(cls, username, work_id, observations):
+        """
+        Stores a patron's observations for a work, so that the stored set
+        matches the submitted list of {label: value_name} dictionaries.
+        """
+        oldb = db.get_db()
+
+        submitted = set()
+        for observation in observations:
+            for label, value_name in observation.items():
+                type_info = LABEL_LOOKUP[label]
+                submitted.add((type_info['id'], type_info['values'][value_name]))
+
+        existing = {
+            (int(r['type']), int(r['value']))
+            for r in cls.get_patron_observations(username, work_id)
+        }
+
+        to_insert = submitted - existing
+        to_delete = existing - submitted
+
+        if to_insert:
+            oldb.multiple_insert(cls.TABLENAME, [
+                {
+                    'observation_type': type_id,
+                    'observation_value': value_id,
+                    'username': username,
+                    'work_id': work_id,
+                }
+                for type_id, value_id in sorted(to_insert)
+            ])
+
+        for type_id, value_id in sorted(to_delete):
+            oldb.delete(
+                cls.TABLENAME,
+                where=(
+                    'username=$username AND work_id=$work_id '
+                    'AND observation_type=$observation_type '
+                    'AND observation_value=$observation_value'
+                ),
+                vars={
+                    'username': username,
+                    'work_id': work_id,
+                    'observation_type': type_id,
+                    'observation_value': value_id,
+                },
+            )
