+@pytest.mark.posix  # Can't seem to simulate a crash on Windows
+@pytest.mark.parametrize('verbose', [True, False])
+def test_exit_sigterm(qtbot, proc, message_mock, py_proc, verbose):
+    proc.verbose = verbose
+    with qtbot.wait_signal(proc.finished, timeout=10000):
+        proc.start(*py_proc("""
+            import os, signal
+            os.kill(os.getpid(), signal.SIGTERM)
+        """))
+
+    assert not any(m.level == usertypes.MessageLevel.error
+                   for m in message_mock.messages)
+    if verbose:
+        msg = message_mock.messages[-1]
+        assert msg.level == usertypes.MessageLevel.info
+        assert msg.text == (
+            "Testprocess terminated with status 15 (SIGTERM). "
+            f"See :process {proc.pid} for details.")
+    else:
+        assert not message_mock.messages
+
+    assert not proc.outcome.running
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert str(proc.outcome) == 'Testprocess terminated with status 15 (SIGTERM).'
+    assert proc.outcome.state_str() == 'terminated'
+    assert not proc.outcome.was_successful()
+
+
