+func EncodeArtworkID(artID model.ArtworkID) string {
+	token, _ := auth.CreatePublicToken(map[string]any{"id": artID.String()})
 	return token
 }
+
+func DecodeArtworkID(tokenString string) (model.ArtworkID, error) {
+	tok, err := jwtauth.VerifyToken(auth.TokenAuth, tokenString)
+	if err != nil || tok == nil {
+		return model.ArtworkID{}, ErrInvalidJWT
+	}
+	if err := jwt.Validate(tok, jwt.WithRequiredClaim("id")); err != nil {
+		return model.ArtworkID{}, err
+	}
+	claims, err := tok.AsMap(context.Background())
+	if err != nil {
+		return model.ArtworkID{}, ErrInvalidJWT
+	}
+	id, ok := claims["id"].(string)
+	if !ok {
+		return model.ArtworkID{}, errors.New("invalid id type")
+	}
+	artID, err := model.ParseArtworkID(id)
+	if err != nil {
+		return model.ArtworkID{}, errors.New("invalid artwork id")
+	}
+	return artID, nil
+}
