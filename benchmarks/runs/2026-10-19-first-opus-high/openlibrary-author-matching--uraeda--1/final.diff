+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """Returns whether the whole text fits pattern, ignoring case.
+
+        Stands for infogami's `~` operator as ILIKE: every `_` is removed from
+        the pattern, `*` matches any run of characters, and every other character
+        is literal. The vendored infogami still does a case-sensitive LIKE there,
+        with `_` matching a literal underscore.
+        """
+        pieces = pattern.replace("_", "").split("*")
+        regex = ".*".join(re.escape(piece) for piece in pieces)
+        return re.fullmatch(regex, text, re.IGNORECASE | re.DOTALL) is not None
