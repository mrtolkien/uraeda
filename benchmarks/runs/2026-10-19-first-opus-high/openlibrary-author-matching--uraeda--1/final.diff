+def find_author(author):
+    """
+    Searches OL for the existing authors matching an import's author, best first.
+    Owns the matching rules: with both dates, for a person, the first of these
+    steps that keeps any candidate wins:
+      1. name (and its flipped form), both years exact;
+      2. name, dates compatible as author_dates_match says, on a candidate with a birth date;
+      3. alternate_names, both years exact;
+      4. surname, both years exact.
+    Otherwise, the name alone, candidates with the import's years first.
+    Each group is sorted by numeric key.
+
+    :param dict author: Author import dict {"name": "Some One"}
+    :rtype: list
+    :return: A list of OL author representations that match author
+    """
+    name = author['name']
+    is_person = author.get('entity_type') in (None, '', 'person')
+    names = [name]
+    if is_person and ', ' in name:
+        names.append(flip_name(name))
+    by_name = _query_authors('name', names)
+
+    if not (is_person and author.get('birth_date') and author.get('death_date')):
+        given = tuple(f for f in ('birth_date', 'death_date') if author.get(f))
+
+        def agrees(a):
+            return _years_match_exactly(author, a, given)
+
+        candidates = _by_key(by_name)
+        return [a for a in candidates if agrees(a)] + [
+            a for a in candidates if not agrees(a)
+        ]
+
+    if exact := [a for a in by_name if _years_match_exactly(author, a)]:
+        return _by_key(exact)
+    if compatible := [
+        a for a in by_name if a.get('birth_date') and author_dates_match(author, a)
+    ]:
+        return _by_key(compatible)
+    by_alternate = _query_authors('alternate_names', names)
+    if exact := [a for a in by_alternate if _years_match_exactly(author, a)]:
+        return _by_key(exact)
+    if not (surname := _get_surname(name)):
+        return []
+    by_surname = _query_authors('name', [f'* {surname}'])
+    return _by_key(a for a in by_surname if _years_match_exactly(author, a))
 
 
