index 00000000..a370eb23
--- /dev/null
+++ b/internal/config/schema_test.go
@@ -0,0 +1,194 @@
+package config
+
+import (
+	"os"
+	"testing"
+	"time"
+
+	"cuelang.org/go/cue"
+	"cuelang.org/go/cue/cuecontext"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCUESchemaDefaultConfig(t *testing.T) {
+	ctx, spec := loadCUESchema(t)
+
+	m := durationsToStrings(decodeConfig(t, DefaultConfig()))
+
+	assert.Equal(t, "1m0s", lookup(m, "cache", "ttl"))
+	assert.Equal(t, "5m0s", lookup(m, "cache", "memory", "eviction_interval"))
+	assert.Equal(t, "24h0m0s", lookup(m, "authentication", "session", "token_lifetime"))
+	assert.Equal(t, "10m0s", lookup(m, "authentication", "session", "state_lifetime"))
+	assert.Equal(t, "2m0s", lookup(m, "audit", "buffer", "flush_period"))
+
+	v := spec.Unify(ctx.Encode(m))
+	require.NoError(t, v.Validate(cue.Concrete(true)))
+}
+
+func TestCUESchemaGitStorageWithoutAuthentication(t *testing.T) {
+	ctx, spec := loadCUESchema(t)
+
+	cfg := DefaultConfig()
+	cfg.Storage = StorageConfig{
+		Type: GitStorageType,
+		Git: &Git{
+			Repository:   "https://github.com/flipt-io/flipt.git",
+			Ref:          "main",
+			PollInterval: 30 * time.Second,
+		},
+	}
+	m := durationsToStrings(decodeConfig(t, cfg))
+
+	v := spec.Unify(ctx.Encode(m))
+	require.NoError(t, v.Validate(cue.Concrete(true)))
+}
+
+func TestCUESchema(t *testing.T) {
+	for _, test := range []struct {
+		name  string
+		input string
+		valid bool
+	}{
+		{
+			name:  "db url",
+			input: `db: {url: "postgres://localhost/flipt", max_idle_conn: 10}`,
+			valid: true,
+		},
+		{
+			name:  "db host without port or user",
+			input: `db: {protocol: "postgres", host: "localhost", name: "flipt"}`,
+			valid: true,
+		},
+		{
+			name:  "db url and host",
+			input: `db: {url: "postgres://localhost/flipt", host: "localhost"}`,
+		},
+		{
+			name:  "storage empty",
+			input: `storage: {}`,
+			valid: true,
+		},
+		{
+			name:  "storage local",
+			input: `storage: {type: "local", local: {path: "/tmp/flags"}}`,
+			valid: true,
+		},
+		{
+			name:  "storage database with leftover local",
+			input: `storage: {type: "database", local: {path: "/tmp/flags"}}`,
+		},
+		{
+			name: "storage git with basic auth",
+			input: `storage: {type: "git", git: {
+				repository: "https://github.com/flipt-io/flipt.git", ref: "main", poll_interval: "5s",
+				authentication: basic: {username: "user", password: "pass"}}}`,
+			valid: true,
+		},
+		{
+			name: "storage git with basic and token auth",
+			input: `storage: {type: "git", git: {
+				repository: "https://github.com/flipt-io/flipt.git", ref: "main", poll_interval: "5s",
+				authentication: {
+					basic: {username: "user", password: "pass"}
+					token: access_token: "s3cr3t"
+				}}}`,
+		},
+		{
+			name:  "cors origins list",
+			input: `cors: allowed_origins: ["foo.com"]`,
+			valid: true,
+		},
+		{
+			name:  "cors origins string",
+			input: `cors: allowed_origins: "foo.com bar.com"`,
+			valid: true,
+		},
+		{
+			name:  "duration with fraction",
+			input: `cache: ttl: "1.5s"`,
+			valid: true,
+		},
+		{
+			name:  "duration zero",
+			input: `cache: ttl: "0s"`,
+			valid: true,
+		},
+		{
+			name:  "duration integer",
+			input: `cache: ttl: 60000000000`,
+			valid: true,
+		},
+		{
+			name:  "duration negative",
+			input: `cache: ttl: "-1m0s"`,
+		},
+		{
+			name: "kubernetes method",
+			input: `authentication: methods: kubernetes: {
+				discovery_url: "https://kubernetes.default.svc.cluster.local"
+				ca_path: "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
+				service_account_token_path: "/var/run/secrets/kubernetes.io/serviceaccount/token"
+			}`,
+			valid: true,
+		},
+	} {
+		test := test
+		t.Run(test.name, func(t *testing.T) {
+			ctx, spec := loadCUESchema(t)
+
+			input := ctx.CompileString(test.input)
+			require.NoError(t, input.Err())
+
+			err := spec.Unify(input).Validate(cue.Concrete(true))
+			if test.valid {
+				assert.NoError(t, err)
+			} else {
+				assert.Error(t, err)
+			}
+		})
+	}
+}
+
+// loadCUESchema compiles the CUE schema of the configuration file and
+// returns its #FliptSpec definition.
+func loadCUESchema(t *testing.T) (*cue.Context, cue.Value) {
+	t.Helper()
+
+	schema, err := os.ReadFile("../../config/flipt.schema.cue")
+	require.NoError(t, err)
+
+	ctx := cuecontext.New()
+	v := ctx.CompileBytes(schema)
+	require.NoError(t, v.Err())
+
+	spec := v.LookupPath(cue.ParsePath("#FliptSpec"))
+	require.NoError(t, spec.Err())
+	require.True(t, spec.Exists())
+
+	return ctx, spec
+}
+
+// durationsToStrings replaces every time.Duration of m, nested maps
+// included, by its string form, as written in a configuration file.
+func durationsToStrings(m map[string]any) map[string]any {
+	for key, value := range m {
+		switch v := value.(type) {
+		case time.Duration:
+			m[key] = v.String()
+		case map[string]any:
+			m[key] = durationsToStrings(v)
+		}
+	}
+
+	return m
+}
+
+func lookup(m map[string]any, path ...string) any {
+	var value any = m
+	for _, key := range path {
+		value = value.(map[string]any)[key]
+	}
+
+	return value
+}
