+func TestDefaultConfigDecode(t *testing.T) {
+	m := decodeConfig(t, DefaultConfig())
+
+	keys := make([]string, 0, len(m))
+	for key := range m {
+		keys = append(keys, key)
+	}
+	assert.ElementsMatch(t, []string{
+		"log", "ui", "cors", "cache", "server", "tracing", "db",
+		"meta", "authentication", "audit", "experimental", "storage",
+	}, keys)
+
+	assert.Equal(t, time.Minute, m["cache"].(map[string]any)["ttl"])
+	assert.NotContains(t, m["db"], "protocol")
+	assertNoNil(t, "", m)
+
+	cfg := DefaultConfig()
+	cfg.Version = "1.0"
+	assert.Equal(t, "1.0", decodeConfig(t, cfg)["version"])
+}
+
+// decodeConfig decodes cfg into a map with the hooks Load uses.
+func decodeConfig(t *testing.T, cfg *Config) map[string]any {
+	t.Helper()
+
+	var m map[string]any
+	decoder, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		DecodeHook: mapstructure.ComposeDecodeHookFunc(DecodeHooks...),
+		Result:     &m,
+	})
+	require.NoError(t, err)
+	require.NoError(t, decoder.Decode(cfg))
+
+	return m
+}
+
+// assertNoNil fails for every nil value found in m or its nested maps.
+func assertNoNil(t *testing.T, path string, m map[string]any) {
+	t.Helper()
+
+	for key, value := range m {
+		switch v := value.(type) {
+		case map[string]any:
+			assertNoNil(t, path+key+".", v)
+		default:
+			rv := reflect.ValueOf(value)
+			if value == nil || (rv.Kind() == reflect.Pointer && rv.IsNil()) {
+				t.Errorf("%s%s is nil", path, key)
+			}
+		}
+	}
+}
+
+func TestStorageConfigDecode(t *testing.T) {
+	res, err := Load("./testdata/storage/database_provided.yml")
+	require.NoError(t, err)
+
+	m := decodeConfig(t, res.Config)
+
+	assert.Equal(t, map[string]any{"type": DatabaseStorageType}, m["storage"])
+}
+
+func TestStorageConfigValidateNilBackend(t *testing.T) {
+	git := &StorageConfig{Type: GitStorageType}
+	assert.EqualError(t, git.validate(), "git ref must be specified")
+
+	local := &StorageConfig{Type: LocalStorageType}
+	assert.EqualError(t, local.validate(), "local path must be specified")
+}
