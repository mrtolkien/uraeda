+def _observation_type(type_id, label, description, multi_choice, values):
+    """Builds a catalog entry from its (value id, name) pairs, in display order."""
+    return {
+        'id': type_id,
+        'label': label,
+        'description': description,
+        'multi_choice': multi_choice,
+        'values': [{'id': value_id, 'name': name} for value_id, name in values],
+        'order': [value_id for value_id, _ in values],
+    }
+
+
+# Stored observations hold only these type and value ids: never renumber or
+# reuse one. See specs/decisions/observation-ids.md.
+OBSERVATION_CATALOG = [
