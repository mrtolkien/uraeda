+def _sort_values(order_list, values_list):
+    """Returns the names of the values whose ids are in `order_list`, in its
+    order. Ids with no value are skipped, and values not listed are left out.
+    """
+    names = {value['id']: value['name'] for value in values_list}
+    return [names[value_id] for value_id in order_list if value_id in names]
+
+
+def get_observations():
+    """Returns every observation type, with its value names in display order."""
+    return {
+        'observations': [
+            {
+                'label': observation_type['label'],
+                'description': observation_type['description'],
+                'multi_choice': observation_type['multi_choice'],
+                'values': _sort_values(
+                    observation_type['order'], observation_type['values']
+                ),
+            }
+            for observation_type in OBSERVATION_CATALOG
+        ]
+    }
+
+
+class Observations(object):
+
+    @classmethod
+    def get_key_value_pair(cls, type_id, value_id):
+        """Returns the label of the type and the name of the value with these ids."""
+        for observation_type in OBSERVATION_CATALOG:
+            if observation_type['id'] != type_id:
+                continue
+            for value in observation_type['values']:
+                if value['id'] == value_id:
+                    return ObservationKeyValue(observation_type['label'], value['name'])
+        raise ValueError(
+            'Unknown observation ids: type %s, value %s' % (type_id, value_id)
+        )
+
+    @classmethod
+    def _get_ids(cls, label, value_name):
+        """Returns the (type id, value id) pair of a label and a value name."""
+        for observation_type in OBSERVATION_CATALOG:
+            if observation_type['label'] != label:
+                continue
+            for value in observation_type['values']:
+                if value['name'] == value_name:
+                    return observation_type['id'], value['id']
+        raise ValueError('Unknown observation: %s: %s' % (label, value_name))
+
+    @classmethod
+    def get_patron_observations(cls, username, work_id):
+        """Returns the patron's observations of the work, as records with
+        `type` and `value` ids, ordered by type, then value.
+        """
+        oldb = db.get_db()
+        query = (
+            "SELECT observation_type AS type, observation_value AS value "
+            "FROM observations WHERE username=$username AND work_id=$work_id "
+            "ORDER BY observation_type, observation_value"
+        )
+        return list(
+            oldb.query(query, vars={'username': username, 'work_id': work_id})
+        )
+
+    @classmethod
+    def persist_observations(cls, username, work_id, observations):
+        """Makes the patron's stored observations of the work equal to
+        `observations`, a list of single-entry {label: value name} dicts.
+
+        Every observation is resolved before any write, and the writes run in
+        one transaction: on an error, the stored observations are unchanged.
+        """
+        submitted = {
+            cls._get_ids(label, value_name)
+            for observation in observations
+            for label, value_name in observation.items()
+        }
+        oldb = db.get_db()
+        with oldb.transaction():
+            stored = {
+                (record['type'], record['value'])
+                for record in cls.get_patron_observations(username, work_id)
+            }
+            rows = [
+                {
+                    'work_id': work_id,
+                    'username': username,
+                    'observation_type': type_id,
+                    'observation_value': value_id,
+                }
+                for type_id, value_id in sorted(submitted - stored)
+            ]
+            if rows:
+                oldb.multiple_insert('observations', rows, seqname=False)
+            for type_id, value_id in sorted(stored - submitted):
+                oldb.delete(
+                    'observations',
+                    where=(
+                        "work_id=$work_id AND username=$username "
+                        "AND observation_type=$type_id "
+                        "AND observation_value=$value_id"
+                    ),
+                    vars={
+                        'work_id': work_id,
+                        'username': username,
+                        'type_id': type_id,
+                        'value_id': value_id,
+                    },
+                )
