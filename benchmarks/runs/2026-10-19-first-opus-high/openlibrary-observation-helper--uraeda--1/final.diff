+import os
+import re
+
+import pytest
+import web
+
+from openlibrary.core import db
+from openlibrary.core.observations import (
+    OBSERVATION_CATALOG,
+    Observations,
+    _sort_values,
+    get_observations,
+)
+
+SCHEMA_PATH = os.path.join(
+    os.path.dirname(__file__), os.pardir, os.pardir, 'core', 'schema.sql'
+)
+
+SQLITE_DDL = """
+CREATE TABLE observations (
+    work_id integer NOT NULL,
+    username text NOT NULL,
+    observation_type integer NOT NULL,
+    observation_value integer NOT NULL,
+    created timestamp,
+    primary key (work_id, username, observation_type, observation_value)
+)
+"""
+
+
+def _schema_ddl():
+    with open(SCHEMA_PATH) as f:
+        match = re.search(r'CREATE TABLE observations \(.*?\);', f.read(), re.S)
+    if not match:
+        pytest.fail('could not find CREATE TABLE observations in schema.sql')
+    return match.group(0)
+
+
+def _connect(backend):
+    if backend == 'sqlite':
+        return web.database(dbn='sqlite', db=':memory:'), SQLITE_DDL
+    name = os.environ.get('OL_TEST_POSTGRES_DB')
+    if not name:
+        pytest.skip('OL_TEST_POSTGRES_DB is not set')
+    return web.database(dbn='postgres', db=name), _schema_ddl()
+
+
+@pytest.fixture(params=['sqlite', 'postgres'])
+def observations_db(request, monkeypatch):
+    """A database with an empty observations table, returned by db.get_db()."""
+    oldb, ddl = _connect(request.param)
+    oldb.printing = False
+    oldb.query(ddl)
+    monkeypatch.setattr(db, 'get_db', lambda: oldb)
+    yield oldb
+    oldb.query('DROP TABLE observations')
+    oldb.ctx.db.close()
+
+
+def _row(type_id, value_id, username='alice', work_id='123'):
+    return {
+        'work_id': work_id,
+        'username': username,
+        'observation_type': type_id,
+        'observation_value': value_id,
+    }
+
+
+def test_table_round_trip(observations_db):
+    with observations_db.transaction():
+        observations_db.multiple_insert(
+            'observations', [_row(1, 1), _row(10, 7)], seqname=False
+        )
+        observations_db.delete(
+            'observations',
+            where=(
+                'work_id=$work_id AND username=$username '
+                'AND observation_type=$observation_type '
+                'AND observation_value=$observation_value'
+            ),
+            vars=_row(1, 1),
+        )
+
+    rows = list(
+        observations_db.query(
+            'SELECT work_id, observation_type AS type, observation_value AS value '
+            'FROM observations ORDER BY observation_type, observation_value'
+        )
+    )
+
+    assert [(r['type'], r['value']) for r in rows] == [(10, 7)]
+    assert rows[0].work_id == 123
+
+
+def test_table_primary_key(observations_db):
+    observations_db.insert('observations', seqname=False, **_row(1, 1))
+
+    with pytest.raises(Exception):
+        observations_db.insert('observations', seqname=False, **_row(1, 1))
+
+
+def test_olid_work_id_is_rejected(observations_db):
+    if observations_db.dbname != 'postgres':
+        pytest.skip('SQLite does not type its columns')
+
+    with pytest.raises(Exception):
+        with observations_db.transaction():
+            observations_db.insert(
+                'observations', seqname=False, **_row(1, 1, work_id='OL123W')
+            )
+
+    assert list(observations_db.query('SELECT * FROM observations')) == []
+
+
+VALUES = [
+    {'id': 1, 'name': 'slow'},
+    {'id': 2, 'name': 'medium'},
+    {'id': 3, 'name': 'fast'},
+]
+
+
+def _entry(label):
+    entries = get_observations()['observations']
+    return next(e for e in entries if e['label'] == label)
+
+
+def test_sort_values_in_order_list_order():
+    assert _sort_values([3, 1, 2], VALUES) == ['fast', 'slow', 'medium']
+
+
+def test_sort_values_misaligned():
+    assert _sort_values([2, 9, 1], VALUES) == ['medium', 'slow']
+
+
+def test_sort_values_empty_lists():
+    assert _sort_values([], VALUES) == []
+    assert _sort_values([1, 2], []) == []
+
+
+def test_sort_values_duplicate_id():
+    assert _sort_values([1, 1], VALUES) == ['slow', 'slow']
+
+
+def test_catalog_has_13_types_in_id_order():
+    entries = get_observations()['observations']
+
+    assert [e['label'] for e in entries] == [
+        'pace', 'entertainment', 'clarity', 'jargon', 'originality',
+        'difficulty', 'usefulness', 'coverage', 'objectivity', 'genres',
+        'fictionality', 'audience', 'mood',
+    ]
+    for entry in entries:
+        assert set(entry) == {'label', 'description', 'multi_choice', 'values'}
+
+
+def test_pace_entry():
+    assert _entry('pace') == {
+        'label': 'pace',
+        'description': 'What is the pace of this book?',
+        'multi_choice': False,
+        'values': ['slow', 'medium', 'fast'],
+    }
+
+
+def test_fictionality_values():
+    assert _entry('fictionality')['values'] == ['nonfiction', 'fiction', 'biography']
+
+
+def test_genres_entry():
+    genres = _entry('genres')
+
+    assert genres['multi_choice'] is True
+    assert len(genres['values']) == 24
+    assert genres['values'][:3] == ['biographical', 'textbook', 'reference']
+    assert genres['values'][17] == 'mystery'
+
+
+def test_catalog_ids_are_consistent():
+    type_ids = [t['id'] for t in OBSERVATION_CATALOG]
+
+    assert type_ids == list(range(1, 14))
+    for observation_type in OBSERVATION_CATALOG:
+        value_ids = [v['id'] for v in observation_type['values']]
+        assert len(value_ids) == len(set(value_ids))
+        assert sorted(observation_type['order']) == sorted(value_ids)
+
+
+def test_key_value_pair_pace_slow():
+    result = Observations.get_key_value_pair(1, 1)
+
+    key, value = result
+    assert (result.key, result.value) == ('pace', 'slow')
+    assert (key, value) == ('pace', 'slow')
+
+
+def test_key_value_pair_genres_mystery():
+    result = Observations.get_key_value_pair(10, 7)
+
+    assert (result.key, result.value) == ('genres', 'mystery')
+
+
+@pytest.mark.parametrize('type_id, value_id', [(1, 4), (99, 1)])
+def test_key_value_pair_unknown_ids(type_id, value_id):
+    message = 'Unknown observation ids: type %d, value %d' % (type_id, value_id)
+
+    with pytest.raises(ValueError, match='^%s$' % re.escape(message)):
+        Observations.get_key_value_pair(type_id, value_id)
+
+
+def test_catalog_reads_need_no_database(monkeypatch):
+    def no_database():
+        raise AssertionError('the database was used')
+
+    monkeypatch.setattr(db, 'get_db', no_database)
+
+    assert get_observations()['observations']
+    assert Observations.get_key_value_pair(11, 3).value == 'biography'
+
+
+def persist(username, work_id, observations):
+    Observations.persist_observations(username, work_id, observations)
+
+
+def pairs(username, work_id):
+    records = Observations.get_patron_observations(username, work_id)
+    return [(record['type'], record['value']) for record in records]
+
+
+def test_persist_then_read(observations_db):
+    persist('alice', '123', [{'pace': 'slow'}, {'genres': 'mystery'}])
+
+    assert pairs('alice', '123') == [(1, 1), (10, 7)]
+
+
+def test_nothing_stored(observations_db):
+    assert Observations.get_patron_observations('alice', '123') == []
+
+
+def test_stored_row(observations_db):
+    persist('alice', '123', [{'pace': 'slow'}])
+
+    rows = list(observations_db.query('SELECT * FROM observations'))
+
+    assert len(rows) == 1
+    assert (rows[0].observation_type, rows[0].observation_value) == (1, 1)
+    assert (rows[0].username, rows[0].work_id) == ('alice', 123)
+
+
+def test_resubmission_replaces_the_set(observations_db, monkeypatch):
+    persist('alice', '123', [{'pace': 'slow'}, {'genres': 'mystery'}])
+    inserted = []
+    multiple_insert = observations_db.multiple_insert
+
+    def recording_insert(tablename, values, **kwargs):
+        inserted.extend(
+            (row['observation_type'], row['observation_value']) for row in values
+        )
+        return multiple_insert(tablename, values, **kwargs)
+
+    monkeypatch.setattr(observations_db, 'multiple_insert', recording_insert)
+
+    persist('alice', '123', [{'pace': 'fast'}, {'genres': 'mystery'}])
+
+    assert pairs('alice', '123') == [(1, 3), (10, 7)]
+    assert inserted == [(1, 3)]
+
+
+def test_empty_submission_clears_only_that_work(observations_db):
+    persist('alice', '123', [{'pace': 'slow'}])
+    persist('alice', '456', [{'pace': 'slow'}])
+    persist('bob', '123', [{'pace': 'slow'}])
+
+    persist('alice', '123', [])
+
+    assert pairs('alice', '123') == []
+    assert pairs('alice', '456') == [(1, 1)]
+    assert pairs('bob', '123') == [(1, 1)]
+
+
+@pytest.mark.parametrize('submission, unknown', [
+    ([{'pace': 'slow'}, {'pace': 'very slow'}], 'pace: very slow'),
+    ([{'pace': 'fast'}, {'pace': 'very slow'}], 'pace: very slow'),
+    ([{'pace': 'mystery'}], 'pace: mystery'),
+    ([{'speed': 'slow'}], 'speed: slow'),
+])
+def test_unknown_observation_changes_nothing(observations_db, submission, unknown):
+    persist('alice', '123', [{'pace': 'slow'}])
+
+    with pytest.raises(ValueError, match='^Unknown observation: %s$' % unknown):
+        persist('alice', '123', submission)
+
+    assert pairs('alice', '123') == [(1, 1)]
+
+
+def test_duplicate_value_stored_once(observations_db):
+    persist('alice', '123', [{'genres': 'mystery'}, {'genres': 'mystery'}])
+
+    assert pairs('alice', '123') == [(10, 7)]
+
+
+def test_two_paces_are_stored(observations_db):
+    persist('alice', '123', [{'pace': 'slow'}, {'pace': 'fast'}])
+
+    assert pairs('alice', '123') == [(1, 1), (1, 3)]
+
+
+def test_failure_rolls_back(observations_db, monkeypatch):
+    persist('alice', '123', [{'pace': 'slow'}])
+
+    def failing_delete(*args, **kwargs):
+        raise RuntimeError('database failure')
+
+    monkeypatch.setattr(observations_db, 'delete', failing_delete)
+
+    with pytest.raises(RuntimeError):
+        persist('alice', '123', [{'pace': 'fast'}])
+
+    assert pairs('alice', '123') == [(1, 1)]
