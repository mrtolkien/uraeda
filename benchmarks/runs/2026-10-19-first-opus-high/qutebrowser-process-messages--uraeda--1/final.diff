+def _stop_sleeping_proc(qtbot, proc, py_proc, *, kill):
+    """Start a process which sleeps, then terminate or kill it."""
+    with qtbot.wait_signal(proc.started, timeout=10000):
+        proc.start(*py_proc('import time; time.sleep(60)'))
+    with qtbot.wait_signal(proc.finished, timeout=10000):
+        proc.terminate(kill=kill)
+
+
+@pytest.mark.posix
+def test_exit_kill(qtbot, proc, message_mock, py_proc, caplog):
+    with caplog.at_level(logging.ERROR):
+        _stop_sleeping_proc(qtbot, proc, py_proc, kill=True)
+
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert proc.outcome.code == 9
+    assert str(proc.outcome) == 'Testprocess crashed with status 9 (SIGKILL).'
+    assert proc.outcome.state_str() == 'crashed'
+    assert not proc.outcome.was_successful()
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text == (
+        "Testprocess crashed with status 9 (SIGKILL). "
+        f"See :process {proc.pid} for details.")
+
+
+@pytest.mark.posix
+def test_exit_sigterm(qtbot, proc, message_mock, py_proc, caplog):
+    with caplog.at_level(logging.ERROR):
+        _stop_sleeping_proc(qtbot, proc, py_proc, kill=False)
+
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert proc.outcome.code == 15
+    assert str(proc.outcome) == 'Testprocess terminated with status 15 (SIGTERM).'
+    assert proc.outcome.state_str() == 'terminated'
+    assert not proc.outcome.was_successful()
+
+    assert not message_mock.messages
+
+
+@pytest.mark.posix
+def test_exit_sigterm_verbose(qtbot, proc, message_mock, py_proc):
+    proc.verbose = True
+    _stop_sleeping_proc(qtbot, proc, py_proc, kill=False)
+
+    msgs = message_mock.messages
+    assert msgs[-1].level == usertypes.MessageLevel.info
+    assert msgs[-1].text == (
+        "Testprocess terminated with status 15 (SIGTERM). "
+        f"See :process {proc.pid} for details.")
+    assert not [msg for msg in msgs if msg.level == usertypes.MessageLevel.error]
+
+
+@pytest.mark.posix
+def test_exit_sigterm_output(qtbot, proc, message_mock, py_proc, caplog):
+    """A SIGTERM stop only changes the message: output is logged, data is kept."""
+    proc._output_messages = True
+    code = """
+        import sys, time
+        print("oops", file=sys.stderr, flush=True)
+        time.sleep(60)
+    """
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc._proc.readyReadStandardError, timeout=10000):
+            proc.start(*py_proc(code))
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.terminate()
+
+    assert {(msg.level, msg.text) for msg in message_mock.messages} == {
+        (usertypes.MessageLevel.error, 'oops'),
+    }
+    assert 'Process stderr:\noops' in caplog.messages
+    assert not proc._cleanup_timer.isActive()
+
+
+def test_exit_unsuccessful_other_process_started(qtbot, proc, message_mock, py_proc,
+                                                 caplog, tmp_path):
+    """The message points to the process which failed, not the last one started."""
+    flag = tmp_path / 'exit-now'
+    cmd, args = py_proc(
+        'import os, sys, time; '
+        '[time.sleep(0.01) for _ in iter(lambda: os.path.exists(sys.argv[1]), True)]; '
+        'sys.exit(1)')
+    second = guiprocess.GUIProcess('testprocess')
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.started, timeout=10000):
+            proc.start(cmd, args + [str(flag)])
+        with qtbot.wait_signal(second.started, timeout=10000):
+            second.start(*py_proc('import time; time.sleep(60)'))
+        assert guiprocess.last_pid == second.pid != proc.pid
+
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            flag.touch()
+
+        msg = message_mock.getmsg(usertypes.MessageLevel.error)
+        assert msg.text.endswith(f"See :process {proc.pid} for details.")
+
+        with qtbot.wait_signal(second.finished, timeout=10000):
+            second.terminate(kill=True)
+
+
+@pytest.mark.parametrize('sig', [
+    signal.SIGSEGV, signal.SIGABRT, signal.SIGTERM,
+])
+def test_crash_signal_names(sig):
+    outcome = guiprocess.ProcessOutcome(
+        'testprocess', status=QProcess.ExitStatus.CrashExit, code=sig.value)
+    state = 'terminated' if sig == signal.SIGTERM else 'crashed'
+    assert str(outcome) == (
+        f'Testprocess {state} with status {sig.value} ({sig.name}).')
+    assert outcome.state_str() == state
+
+
+@pytest.mark.parametrize('code', [-1, 0])
+def test_crash_without_signal_name(code):
+    outcome = guiprocess.ProcessOutcome(
+        'testprocess', status=QProcess.ExitStatus.CrashExit, code=code)
+    assert str(outcome) == f'Testprocess crashed with status {code}.'
+    assert outcome.state_str() == 'crashed'
+
+
+@pytest.mark.parametrize('code', [0, 11, 15])
+def test_crash_without_signal_name_windows(monkeypatch, code):
+    """Crash codes on Windows are no signals, even when Python has a name for them."""
+    monkeypatch.setattr(guiprocess.utils, 'is_windows', True)
+    outcome = guiprocess.ProcessOutcome(
+        'testprocess', status=QProcess.ExitStatus.CrashExit, code=code)
+    state = 'terminated' if code == 15 else 'crashed'
+    assert str(outcome) == f'Testprocess {state} with status {code}.'
+
+
+@pytest.mark.parametrize('code', [15, 143])
+def test_exit_status_15(qtbot, proc, message_mock, py_proc, caplog, code):
+    """A normal exit with SIGTERM's number (or a shell's 128 + 15) is a failure."""
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc(f'import sys; sys.exit({code})'))
+
+    assert proc.outcome.status == QProcess.ExitStatus.NormalExit
+    assert str(proc.outcome) == f'Testprocess exited with status {code}.'
+    assert proc.outcome.state_str() == 'unsuccessful'
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text == (
+        f'Testprocess exited with status {code}. See :process {proc.pid} for details.')
+
