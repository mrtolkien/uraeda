@@ -0,0 +1,149 @@
+package public_test
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"time"
+
+	"github.com/go-chi/jwtauth/v5"
+	"github.com/navidrome/navidrome/core/artwork"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/server/public"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+type fakeArtwork struct {
+	called bool
+	id     string
+	size   int
+	err    error
+}
+
+func (f *fakeArtwork) Get(_ context.Context, id string, size int) (io.ReadCloser, time.Time, error) {
+	f.called, f.id, f.size = true, id, size
+	if f.err != nil {
+		return nil, time.Time{}, f.err
+	}
+	return io.NopCloser(strings.NewReader("image data")), time.Date(2026, 10, 19, 0, 0, 0, 0, time.UTC), nil
+}
+
+var _ = Describe("Public endpoints", func() {
+	var fake *fakeArtwork
+	var router *public.Router
+	var token string
+
+	get := func(url string) *httptest.ResponseRecorder {
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, httptest.NewRequest("GET", url, nil))
+		return w
+	}
+	publicToken := func(claims map[string]any) string {
+		t, err := auth.CreatePublicToken(claims)
+		Expect(err).ToNot(HaveOccurred())
+		return t
+	}
+
+	BeforeEach(func() {
+		auth.Secret = []byte("test secret")
+		auth.TokenAuth = jwtauth.New("HS256", auth.Secret, nil)
+		fake = &fakeArtwork{}
+		router = public.New(fake)
+		token = artwork.EncodeArtworkID(model.NewArtworkID(model.KindArtistArtwork, "1234"))
+	})
+
+	Describe("/img/{jwt}", func() {
+		It("serves the original image for a token without a size", func() {
+			w := get("/img/" + token)
+
+			Expect(w.Code).To(Equal(http.StatusOK))
+			Expect(w.Body.String()).To(Equal("image data"))
+			Expect(w.Header().Get("cache-control")).To(Equal("public, max-age=315360000"))
+			Expect(w.Header().Get("last-modified")).To(Equal("Mon, 19 Oct 2026 00:00:00 UTC"))
+			Expect(fake.id).To(Equal("ar-1234"))
+			Expect(fake.size).To(Equal(0))
+		})
+
+		DescribeTable("reads the size from the query",
+			func(query string, size int) {
+				w := get("/img/" + token + query)
+
+				Expect(w.Code).To(Equal(http.StatusOK))
+				Expect(fake.size).To(Equal(size))
+			},
+			Entry("asked size", "?size=300", 300),
+			Entry("very large size", "?size=30000", 30000),
+			Entry("missing", "", 0),
+			Entry("zero", "?size=0", 0),
+			Entry("not a number", "?size=abc", 0),
+			Entry("negative", "?size=-5", -5),
+		)
+
+		DescribeTable("answers 404 for a token that cannot be decoded",
+			func(tokenFor func() string) {
+				w := get("/img/" + tokenFor())
+
+				Expect(w.Code).To(Equal(http.StatusNotFound))
+				Expect(fake.called).To(BeFalse())
+			},
+			Entry("malformed", func() string { return "xx-123" }),
+			Entry("signed with another secret", func() string {
+				_, t, _ := jwtauth.New("HS256", []byte("other secret"), nil).Encode(map[string]any{"id": "ar-1234"})
+				return t
+			}),
+			Entry("session token", func() string {
+				t, _ := auth.CreateToken(&model.User{ID: "1", UserName: "admin"})
+				return t
+			}),
+			Entry("id that is not a string", func() string { return publicToken(map[string]any{"id": 1234}) }),
+		)
+
+		Context("with a token issued before the size moved out of it", func() {
+			BeforeEach(func() {
+				token = publicToken(map[string]any{"id": "ar-1234", "size": 0})
+			})
+
+			It("serves the original image", func() {
+				w := get("/img/" + token)
+
+				Expect(w.Code).To(Equal(http.StatusOK))
+				Expect(fake.id).To(Equal("ar-1234"))
+				Expect(fake.size).To(Equal(0))
+			})
+
+			It("serves the size asked in the query", func() {
+				get("/img/" + token + "?size=300")
+				Expect(fake.size).To(Equal(300))
+			})
+		})
+
+		It("decodes the token in the path, not a :jwt in the query", func() {
+			w := get("/img/" + token + "?:jwt=xx-123")
+
+			Expect(w.Code).To(Equal(http.StatusOK))
+			Expect(fake.id).To(Equal("ar-1234"))
+		})
+
+		It("answers 404 when the artwork is not found", func() {
+			fake.err = model.ErrNotFound
+
+			w := get("/img/" + token)
+
+			Expect(w.Code).To(Equal(http.StatusNotFound))
+			Expect(w.Body.String()).To(Equal("Artwork not found\n"))
+		})
+
+		It("answers 500 when the artwork cannot be read", func() {
+			fake.err = errors.New("disk error")
+
+			w := get("/img/" + token)
+
+			Expect(w.Code).To(Equal(http.StatusInternalServerError))
+		})
+	})
+})
