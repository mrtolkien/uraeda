-func PublicLink(artID model.ArtworkID, size int) string {
-	token, _ := auth.CreatePublicToken(map[string]any{
-		"id":   artID.String(),
-		"size": size,
-	})
+func EncodeArtworkID(artID model.ArtworkID) string {
+	token, _ := auth.CreatePublicToken(map[string]any{"id": artID.String()})
 	return token
 }
+
+func DecodeArtworkID(tokenString string) (model.ArtworkID, error) {
+	token, err := jwtauth.VerifyToken(auth.TokenAuth, tokenString)
+	if err != nil {
+		return model.ArtworkID{}, fmt.Errorf("invalid JWT: %w", err)
+	}
+	claims, err := token.AsMap(context.Background())
+	if err != nil {
+		return model.ArtworkID{}, err
+	}
+	id, ok := claims["id"]
+	if !ok {
+		return model.ArtworkID{}, errors.New("missing id claim")
+	}
+	idStr, ok := id.(string)
+	if !ok {
+		return model.ArtworkID{}, errors.New("invalid id type")
+	}
+	return model.ParseArtworkID(idStr)
+}
