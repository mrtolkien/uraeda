         assert self.code is not None
         return self.status == QProcess.ExitStatus.NormalExit and self.code == 0
 
+    def _signal(self) -> Optional[signal.Signals]:
+        """Get the signal which killed the process, if known."""
+        if self.status != QProcess.ExitStatus.CrashExit or self.code is None:
+            return None
+        try:
+            return signal.Signals(self.code)
+        except ValueError:
+            return None
+
+    def was_sigterm(self) -> bool:
+        """Whether the process was terminated by SIGTERM."""
+        return self._signal() == signal.SIGTERM
+
