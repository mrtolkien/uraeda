+@pytest.mark.posix
+def test_exit_sigterm_silent(qtbot, proc, message_mock, py_proc, caplog):
+    with caplog.at_level(logging.DEBUG):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc("""
+                import os, signal, sys
+                print("test", flush=True)
+                print("test", file=sys.stderr, flush=True)
+                os.kill(os.getpid(), signal.SIGTERM)
+            """))
+
+    assert not message_mock.messages
+    assert not [r for r in caplog.records if r.levelno >= logging.ERROR]
+    assert proc.outcome.state_str() == 'terminated'
+    assert not proc.outcome.was_successful()
+
+
+@pytest.mark.posix
+def test_exit_sigterm_verbose(qtbot, proc, message_mock, py_proc):
+    proc.verbose = True
+    with qtbot.wait_signal(proc.finished, timeout=10000):
+        proc.start(*py_proc(_kill_self_code(signal.SIGTERM)))
+
+    msg = message_mock.messages[-1]
+    assert msg.level == usertypes.MessageLevel.info
+    assert msg.text == (
+        f"Testprocess terminated with status 15 (SIGTERM). "
+        f"See :process {proc.pid} for details.")
+    assert not [m for m in message_mock.messages
+                if m.level == usertypes.MessageLevel.error]
+    assert str(proc.outcome) == "Testprocess terminated with status 15 (SIGTERM)."
+    assert proc.outcome.state_str() == 'terminated'
+    assert not proc.outcome.was_successful()
+
+
+def test_outcome_unknown_signal():
+    outcome = guiprocess.ProcessOutcome(
+        what="testprocess", status=QProcess.ExitStatus.CrashExit, code=0xC0000005)
+    assert str(outcome) == "Testprocess crashed."
+    assert outcome.state_str() == 'crashed'
+
+
+def test_exit_unsuccessful_own_pid(qtbot, proc, message_mock, py_proc, caplog):
+    other = guiprocess.GUIProcess('other')
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc('import time; time.sleep(0.2); import sys; sys.exit(1)'))
+            other.start(*py_proc(''))
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert f":process {proc.pid} " in msg.text
+    assert proc.pid != other.pid
+
