index 000000000..2c499d687
--- /dev/null
+++ b/openlibrary/tests/core/test_observations.py
@@ -0,0 +1,162 @@
+import pytest
+import web
+
+from openlibrary.core import db, observations
+from openlibrary.core.observations import Observations, _sort_values, get_observations
+
+
+def test_sort_values_follows_order_list():
+    values = [{'id': 1, 'name': 'a'}, {'id': 2, 'name': 'b'}, {'id': 3, 'name': 'c'}]
+    assert _sort_values([3, 1, 2], values) == ['c', 'a', 'b']
+
+
+def test_sort_values_absorbs_ids_without_value():
+    values = [{'id': 1, 'name': 'a'}, {'id': 3, 'name': 'c'}]
+    assert _sort_values([3, 9, 1], values) == ['c', 'a']
+
+
+def test_sort_values_excludes_values_not_in_order_list():
+    values = [{'id': 1, 'name': 'a'}, {'id': 2, 'name': 'b'}]
+    assert _sort_values([1], values) == ['a']
+
+
+def test_sort_values_no_duplicate_for_repeated_id():
+    assert _sort_values([1, 1], [{'id': 1, 'name': 'a'}]) == ['a']
+
+
+def _entry(label):
+    return next(o for o in get_observations()['observations'] if o['label'] == label)
+
+
+def test_get_observations_entries_have_the_keys():
+    entries = get_observations()['observations']
+    assert entries
+    for entry in entries:
+        assert {'label', 'description', 'multi_choice', 'values'} <= set(entry)
+
+
+def test_get_observations_pace():
+    pace = _entry('pace')
+    assert pace['multi_choice'] is False
+    assert pace['values'] == ['slow', 'medium', 'fast']
+
+
+def test_get_observations_fictionality():
+    assert _entry('fictionality')['values'] == ['nonfiction', 'fiction', 'biography']
+
+
+def test_get_key_value_pair_pace():
+    result = Observations.get_key_value_pair(1, 1)
+    assert (result.key, result.value) == ('pace', 'slow')
+
+
+def test_get_key_value_pair_genres_unpacks():
+    key, value = Observations.get_key_value_pair(10, 7)
+    assert (key, value) == ('genres', 'mystery')
+
+
+def test_get_key_value_pair_unknown_id():
+    with pytest.raises(KeyError):
+        Observations.get_key_value_pair(99, 1)
+    with pytest.raises(KeyError):
+        Observations.get_key_value_pair(1, 99)
+
+
+@pytest.fixture
+def oldb(monkeypatch):
+    database = web.database(dbn='sqlite', db=':memory:')
+    database.query(
+        "create table observations (username text not null, work_id integer not null,"
+        " observation_type integer not null, observation_value integer not null,"
+        " created timestamp default current_timestamp,"
+        " primary key (username, work_id, observation_type, observation_value))"
+    )
+    monkeypatch.setattr(db, 'get_db', lambda: database)
+    return database
+
+
+def stored(oldb, username, work_id):
+    rows = oldb.query(
+        "select observation_type, observation_value from observations"
+        " where username=$u and work_id=$w order by 1, 2",
+        vars={'u': username, 'w': work_id},
+    )
+    return [(r.observation_type, r.observation_value) for r in rows]
+
+
+def seed(oldb, username, work_id, *pairs):
+    for t, v in pairs:
+        oldb.insert('observations', username=username, work_id=work_id,
+                    observation_type=t, observation_value=v)
+
+
+def test_persist_replaces_value(oldb):
+    seed(oldb, 'alice', 100, (1, 1))
+    Observations.persist_observations('alice', '100', [{'pace': 'fast'}])
+    assert stored(oldb, 'alice', 100) == [(1, 3)]
+
+
+def test_persist_drops_other_type_and_keeps_shared_value_once(oldb):
+    seed(oldb, 'alice', 100, (1, 1), (10, 7))
+    Observations.persist_observations('alice', '100', [{'pace': 'slow'}])
+    assert stored(oldb, 'alice', 100) == [(1, 1)]
+
+
+def test_persist_empty_clears_work_only(oldb):
+    seed(oldb, 'alice', 100, (1, 1))
+    seed(oldb, 'alice', 200, (1, 2))
+    Observations.persist_observations('alice', '100', [])
+    assert stored(oldb, 'alice', 100) == []
+    assert stored(oldb, 'alice', 200) == [(1, 2)]
+
+
+def test_persist_leaves_other_patron(oldb):
+    seed(oldb, 'bob', 100, (1, 1))
+    Observations.persist_observations('alice', '100', [{'pace': 'fast'}])
+    assert stored(oldb, 'bob', 100) == [(1, 1)]
+
+
+@pytest.mark.parametrize('bad', [{'color': 'red'}, {'pace': 'quick'}])
+def test_persist_invalid_stores_nothing(oldb, bad):
+    seed(oldb, 'alice', 100, (1, 3))
+    with pytest.raises(ValueError):
+        Observations.persist_observations('alice', '100', [{'pace': 'slow'}, bad])
+    assert stored(oldb, 'alice', 100) == [(1, 3)]
+
+
+def test_persist_string_work_id(oldb):
+    Observations.persist_observations('alice', '100', [{'pace': 'slow'}])
+    assert stored(oldb, 'alice', 100) == [(1, 1)]
+
+
+def test_persist_duplicate_entry_once(oldb):
+    Observations.persist_observations('alice', '100', [{'pace': 'slow'}, {'pace': 'slow'}])
+    assert stored(oldb, 'alice', 100) == [(1, 1)]
+
+
+def test_persist_reads_every_item_of_an_entry(oldb):
+    Observations.persist_observations('alice', '100', [{'pace': 'slow', 'genres': 'mystery'}])
+    assert stored(oldb, 'alice', 100) == [(1, 1), (10, 7)]
+
+
+def test_persist_rolls_back_on_insert_failure(oldb, monkeypatch):
+    seed(oldb, 'alice', 100, (1, 1))
+
+    def boom(*args, **kwargs):
+        raise RuntimeError('insert failed')
+
+    monkeypatch.setattr(oldb, 'multiple_insert', boom)
+    monkeypatch.setattr(oldb, 'insert', boom)
+    with pytest.raises(RuntimeError):
+        Observations.persist_observations('alice', '100', [{'pace': 'fast'}])
+    assert stored(oldb, 'alice', 100) == [(1, 1)]
+
+
+def test_get_patron_observations(oldb):
+    seed(oldb, 'alice', 100, (1, 1))
+    records = Observations.get_patron_observations('alice', '100')
+    assert [(r['type'], r['value']) for r in records] == [(1, 1)]
+
+
+def test_get_patron_observations_empty(oldb):
+    assert Observations.get_patron_observations('alice', '300') == []
