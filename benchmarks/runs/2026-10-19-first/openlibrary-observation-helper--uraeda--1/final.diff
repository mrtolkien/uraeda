 """Module for handling patron observation functionality"""
 
+from collections import namedtuple
+
 import requests
 
 from infogami import config
 from openlibrary import accounts
-from . import cache
+from . import cache, db
 
 # URL for TheBestBookOn
 TBBO_URL = config.get('tbbo_url')
@@ -24,3 +26,147 @@ def get_aspects():
     response = requests.get(TBBO_URL + '/api/aspects')
 
     return response.text
+
+
+def _values(*names):
+    return [{'id': i, 'name': name} for i, name in enumerate(names, 1)]
+
+
+# Stored rows reference these ids: they must not change once rows exist.
+OBSERVATIONS = [
+    {
+        'id': 1,
+        'label': 'pace',
+        'description': 'How quickly does the story move?',
+        'multi_choice': False,
+        'values': _values('slow', 'medium', 'fast'),
+    },
+    {
+        'id': 2,
+        'label': 'fictionality',
+        'description': 'Is the book fiction or nonfiction?',
+        'multi_choice': False,
+        'values': _values('nonfiction', 'fiction', 'biography'),
+    },
+    {
+        'id': 10,
+        'label': 'genres',
+        'description': 'Which genres does the book belong to?',
+        'multi_choice': True,
+        'values': _values('fantasy', 'science fiction', 'romance', 'history', 'horror',
+                          'thriller', 'mystery', 'humor', 'poetry'),
+    },
+]
+
+
+def _sort_values(order_list, values_list):
+    """Returns the names of the values whose id is in `order_list`, in that order.
+
+    Ids of `order_list` with no value are skipped, values whose id is not in
+    `order_list` are left out, and an id listed twice gives one name.
+    """
+    names = {value['id']: value['name'] for value in values_list}
+    ordered = []
+    for value_id in order_list:
+        if value_id in names and names[value_id] not in ordered:
+            ordered.append(names[value_id])
+    return ordered
+
+
+def get_observations():
+    """Returns the observation types, each with its value names in display order."""
+    return {
+        'observations': [
+            {
+                'label': observation['label'],
+                'description': observation['description'],
+                'multi_choice': observation['multi_choice'],
+                'values': _sort_values(
+                    sorted(value['id'] for value in observation['values']),
+                    observation['values']),
+            }
+            for observation in OBSERVATIONS
+        ]
+    }
+
+
+KeyValuePair = namedtuple('KeyValuePair', 'key value')
+
+
+def _get_type(type_id):
+    for observation in OBSERVATIONS:
+        if observation['id'] == type_id:
+            return observation
+    raise KeyError(type_id)
+
+
+class Observations(object):
+
+    @classmethod
+    def get_key_value_pair(cls, type_id, value_id):
+        """Returns the type label and value name of a type id and a value id.
+        Raises KeyError when either id is not in the catalog.
+        """
+        observation = _get_type(type_id)
+        for value in observation['values']:
+            if value['id'] == value_id:
+                return KeyValuePair(observation['label'], value['name'])
+        raise KeyError(value_id)
+
+    @classmethod
+    def _to_ids(cls, observations):
+        """Returns the set of (type id, value id) of submitted `{label: value_name}`
+        entries. Raises ValueError for a label or value not in the catalog.
+        """
+        ids = set()
+        for entry in observations:
+            for label, name in entry.items():
+                for observation in OBSERVATIONS:
+                    if observation['label'] == label:
+                        break
+                else:
+                    raise ValueError('Unknown observation: %r' % label)
+                for value in observation['values']:
+                    if value['name'] == name:
+                        ids.add((observation['id'], value['id']))
+                        break
+                else:
+                    raise ValueError('Unknown value %r for %r' % (name, label))
+        return ids
+
+    @classmethod
+    def persist_observations(cls, username, work_id, observations):
+        """Makes the patron's stored observations for the work equal `observations`,
+        a list of `{label: value_name}` dicts. Nothing changes if one is invalid.
+        """
+        submitted = cls._to_ids(observations)
+        work_id = int(work_id)
+        oldb = db.get_db()
+        with oldb.transaction():
+            rows = oldb.query(
+                "SELECT observation_type, observation_value FROM observations"
+                " WHERE username=$username AND work_id=$work_id",
+                vars={'username': username, 'work_id': work_id})
+            stored = {(r.observation_type, r.observation_value) for r in rows}
+            for type_id, value_id in sorted(stored - submitted):
+                oldb.delete(
+                    'observations',
+                    where="username=$username AND work_id=$work_id"
+                          " AND observation_type=$type_id AND observation_value=$value_id",
+                    vars={'username': username, 'work_id': work_id,
+                          'type_id': type_id, 'value_id': value_id})
+            for type_id, value_id in sorted(submitted - stored):
+                oldb.insert(
+                    'observations', username=username, work_id=work_id,
+                    observation_type=type_id, observation_value=value_id)
+
+    @classmethod
+    def get_patron_observations(cls, username, work_id):
+        """Returns the patron's stored observations for the work, as records with
+        `type` and `value`.
+        """
+        oldb = db.get_db()
+        query = ("SELECT observation_type AS type, observation_value AS value"
+                 " FROM observations WHERE username=$username AND work_id=$work_id")
+        return list(oldb.query(
+            query, vars={'username': username, 'work_id': int(work_id)}))
