+        dates = {'birth_date': '1900', 'death_date': '1970'}
+        assert found({'name': 'Mark Twain', **dates}) is None
+        assert found({'name': 'J. Smith', **dates}) is None
+
+    def test_year_mismatch_falls_through_to_alternate_name(self, mock_site):
+        dates = {'birth_date': '1900', 'death_date': '1970'}
+        save_author(mock_site, 1, 'John Smith', birth_date='1800', death_date='1870')
+        save_author(mock_site, 2, 'Other', alternate_names=['John Smith'], **dates)
+        assert found({'name': 'John Smith', **dates}) == '/authors/OL2A'
+
+    def test_same_record_found_twice_is_one_candidate(self, mock_site):
+        save_author(mock_site, 1, 'a, a')
+        assert len(load_book.find_author({'name': '*, *'})) == 1
+
+    def test_surname_step_with_star_or_empty_name(self, mock_site):
+        dates = {'birth_date': '1900', 'death_date': '1970'}
+        save_author(mock_site, 1, 'John Smith', **dates)
+        assert found({'name': 'J. *', **dates}) == '/authors/OL1A'
+        assert found({'name': '', **dates}) is None
+
+    def test_wildcard_returns_lowest_key(self, mock_site):
+        save_author(mock_site, 9, 'John Smith')
+        save_author(mock_site, 3, 'Johnny Cash')
+        assert found({'name': 'John*'}) == '/authors/OL3A'
+
+    def test_unmatched_import_keeps_fields(self, mock_site):
