+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """Mimics the production ILIKE: case-insensitive, matching the full text.
+        `*` matches any run of characters, and `_` is ignored in the pattern.
+        """
+        chunks = pattern.replace("_", "").split("*")
+        regex = ".*".join(re.escape(c) for c in chunks)
+        return re.fullmatch(regex, text, re.IGNORECASE | re.DOTALL) is not None
