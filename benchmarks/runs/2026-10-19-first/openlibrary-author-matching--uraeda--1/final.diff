+def save_author(mock_site, n, name, **fields):
+    mock_site.save(
+        {
+            'key': f'/authors/OL{n}A',
+            'type': {'key': '/type/author'},
+            'name': name,
+            **fields,
+        }
+    )
+
+
+def found(author):
+    existing = load_book.find_entity(author)
+    return existing and existing['key']
+
+
+class TestFindEntity:
+    def test_name_match_ignores_case(self, mock_site):
+        save_author(mock_site, 1, 'John Smith', birth_date='1900', death_date='1970')
+        author = {'name': 'john smith', 'birth_date': '1900', 'death_date': '1970'}
+        assert found(author) == '/authors/OL1A'
+
+    def test_dates_pick_record(self, mock_site):
+        save_author(mock_site, 1, 'John Smith', birth_date='1900', death_date='1970')
+        save_author(mock_site, 2, 'John Smith', birth_date='1950', death_date='2000')
+        author = {'name': 'JOHN SMITH', 'birth_date': '1950', 'death_date': '2000'}
+        assert found(author) == '/authors/OL2A'
+
+    def test_undated_import_matches_dated_author(self, mock_site):
+        save_author(mock_site, 1, 'John Smith', birth_date='1900', death_date='1970')
+        assert found({'name': 'john smith'}) == '/authors/OL1A'
+
+    def test_flipped_name_is_searched(self, mock_site):
+        save_author(mock_site, 1, 'John Smith')
+        assert found({'name': 'Smith, John'}) == '/authors/OL1A'
+
+    def test_one_import_date_matches_on_name(self, mock_site):
+        save_author(mock_site, 1, 'John Smith', birth_date='1950', death_date='2000')
+        assert found({'name': 'John Smith', 'birth_date': '1900'}) == '/authors/OL1A'
+
+    def test_lowest_numeric_key_wins(self, mock_site):
+        save_author(mock_site, 10, 'John Smith')
+        save_author(mock_site, 2, 'John Smith')
+        assert found({'name': 'John Smith'}) == '/authors/OL2A'
+
+    def test_org_returns_first_match(self, mock_site):
+        save_author(mock_site, 1, 'Acme', birth_date='1900')
+        author = {'name': 'acme', 'entity_type': 'org', 'birth_date': '1990'}
+        assert found(author) == '/authors/OL1A'
+
+    def test_redirect_is_followed(self, mock_site):
+        save_author(mock_site, 2, 'John Smith')
+        mock_site.save(
+            {
+                'key': '/authors/OL1A',
+                'type': {'key': '/type/redirect'},
+                'location': '/authors/OL2A',
+                'name': 'John Smith',
+            }
+        )
+        assert found({'name': 'John Smith'}) == '/authors/OL2A'
+
+    @pytest.mark.parametrize(
+        'name, dates, expected',
+        [
+            ('mark twain', ('1835', '1910'), '/authors/OL1A'),
+            ('Mark Twain', ('1835', '1911'), None),
+            ('Mark Twain', ('1835', None), None),
+        ],
+    )
+    def test_alternate_name_match(self, mock_site, name, dates, expected):
+        save_author(
+            mock_site,
+            1,
+            'Samuel Clemens',
+            alternate_names=['Mark Twain'],
+            birth_date='1835',
+            death_date='1910',
+        )
+        author = {'name': name, 'birth_date': dates[0]}
+        if dates[1]:
+            author['death_date'] = dates[1]
+        assert found(author) == expected
+
+    @pytest.mark.parametrize(
+        'dates, expected',
+        [
+            (('1900', '1970'), '/authors/OL1A'),
+            (('1900', '1971'), None),
+            ((None, None), None),
+        ],
+    )
+    def test_surname_match(self, mock_site, dates, expected):
+        save_author(mock_site, 1, 'John Smith', birth_date='1900', death_date='1970')
+        author = {'name': 'J. Smith'}
+        if dates[0]:
+            author.update(birth_date=dates[0], death_date=dates[1])
+        assert found(author) == expected
+
+    def test_name_beats_alternate_name_beats_surname(self, mock_site):
+        dates = {'birth_date': '1900', 'death_date': '1970'}
+        save_author(mock_site, 1, 'Jo Smith', **dates)
+        save_author(mock_site, 2, 'Other', alternate_names=['J. Smith'], **dates)
+        save_author(mock_site, 3, 'J. Smith', **dates)
+        assert found({'name': 'J. Smith', **dates}) == '/authors/OL3A'
+        mock_site.save({'key': '/authors/OL3A', 'type': {'key': '/type/delete'}})
+        assert found({'name': 'J. Smith', **dates}) == '/authors/OL2A'
+
+    def test_later_steps_need_record_dates(self, mock_site):
+        save_author(mock_site, 1, 'Other', alternate_names=['Mark Twain'])
