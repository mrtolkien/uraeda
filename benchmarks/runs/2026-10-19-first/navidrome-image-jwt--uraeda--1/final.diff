 	return artReader, err
 }
 
-func PublicLink(artID model.ArtworkID, size int) string {
+func EncodeArtworkID(artID model.ArtworkID) string {
 	token, _ := auth.CreatePublicToken(map[string]any{
-		"id":   artID.String(),
-		"size": size,
+		"id": artID.String(),
 	})
 	return token
 }
+
+func DecodeArtworkID(tokenString string) (model.ArtworkID, error) {
+	claims, err := auth.Validate(tokenString)
+	if err != nil { // MatchError("invalid JWT") compares the whole message
+		return model.ArtworkID{}, errors.New("invalid JWT")
+	}
+	idClaim, ok := claims["id"]
+	if !ok {
+		return model.ArtworkID{}, errors.New("missing id claim")
+	}
+	id, ok := idClaim.(string)
+	if !ok {
+		return model.ArtworkID{}, errors.New("invalid id type")
+	}
+	artID, err := model.ParseArtworkID(id)
+	if err != nil {
+		return model.ArtworkID{}, errors.New("invalid artwork id")
+	}
+	return artID, nil
+}
