new file mode 100644
index 00000000..d93e410f
--- /dev/null
+++ b/server/public/public_endpoints_test.go
@@ -0,0 +1,76 @@
+package public
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"time"
+
+	"github.com/navidrome/navidrome/core/artwork"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+type fakeArtwork struct {
+	gotID   string
+	gotSize int
+}
+
+func (f *fakeArtwork) Get(_ context.Context, id string, size int) (io.ReadCloser, time.Time, error) {
+	f.gotID, f.gotSize = id, size
+	return io.NopCloser(strings.NewReader("image")), time.Now(), nil
+}
+
+var _ = Describe("Public images", func() {
+	var fake *fakeArtwork
+	var router *Router
+	artID := model.NewArtworkID(model.KindArtistArtwork, "1234")
+
+	get := func(token, query string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest("GET", "/img/"+token+query, nil)
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, req)
+		return w
+	}
+
+	BeforeEach(func() {
+		auth.Init(&tests.MockDataStore{})
+		fake = &fakeArtwork{}
+		router = New(fake)
+	})
+
+	It("serves the original image when there is no size", func() {
+		w := get(artwork.EncodeArtworkID(artID), "")
+		Expect(w.Code).To(Equal(http.StatusOK))
+		Expect(fake.gotID).To(Equal("ar-1234"))
+		Expect(fake.gotSize).To(Equal(0))
+	})
+	It("resizes with the size query parameter", func() {
+		w := get(artwork.EncodeArtworkID(artID), "?size=300")
+		Expect(w.Code).To(Equal(http.StatusOK))
+		Expect(fake.gotSize).To(Equal(300))
+	})
+	It("treats a non-numeric size as 0", func() {
+		w := get(artwork.EncodeArtworkID(artID), "?size=abc")
+		Expect(w.Code).To(Equal(http.StatusOK))
+		Expect(fake.gotSize).To(Equal(0))
+	})
+	It("accepts an old token with a size claim and ignores the claim", func() {
+		token, _ := auth.CreatePublicToken(map[string]any{"id": "ar-1234", "size": 0})
+		w := get(token, "")
+		Expect(w.Code).To(Equal(http.StatusOK))
+		Expect(fake.gotSize).To(Equal(0))
+	})
+	It("answers 404 for an invalid token", func() {
+		Expect(get("xx-123", "").Code).To(Equal(http.StatusNotFound))
+	})
+	It("answers 404 for a signed token without an id", func() {
+		token, _ := auth.CreatePublicToken(map[string]any{"size": 0})
+		Expect(get(token, "").Code).To(Equal(http.StatusNotFound))
+	})
+})
