+// stringifyForSchema returns a copy of a decoded configuration map where durations and enums
+// are in the string form the schema expects.
+func stringifyForSchema(v any) any {
+	switch v := v.(type) {
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, e := range v {
+			out[k] = stringifyForSchema(e)
+		}
+		return out
+	case time.Duration:
+		return v.String()
+	case LogEncoding:
+		return v.String()
+	case CacheBackend:
+		return v.String()
+	case TracingExporter:
+		return v.String()
+	case Scheme:
+		return v.String()
+	case DatabaseProtocol:
+		return v.String()
+	}
+	return v
+}
+
+func decodeConfig(t *testing.T, cfg *Config) map[string]any {
+	t.Helper()
+
+	out := map[string]any{}
+	dec, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		DecodeHook: mapstructure.ComposeDecodeHookFunc(DecodeHooks...),
+		Result:     &out,
+	})
+	require.NoError(t, err)
+	require.NoError(t, dec.Decode(cfg))
+
+	return out
+}
+
+func lookup(m map[string]any, path ...string) (any, bool) {
+	var cur any = m
+	for _, p := range path {
+		next, ok := cur.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		if cur, ok = next[p]; !ok {
+			return nil, false
+		}
+	}
+	return cur, true
+}
+
+func TestDefaultConfigValidatesAgainstSchema(t *testing.T) {
+	decoded := decodeConfig(t, DefaultConfig())
+
+	require.NoError(t, validateAgainstSchema(t, stringifyForSchema(decoded).(map[string]any)))
+
+	for _, section := range []string{"log", "ui", "cors", "cache", "server", "tracing", "db", "meta", "authentication", "audit", "experimental", "storage"} {
+		assert.Contains(t, decoded, section)
+	}
+
+	for _, absent := range [][]string{
+		{"version"},
+		{"authentication", "methods", "oidc", "cleanup"},
+		{"db", "protocol"},
+		{"db", "max_open_conn"},
+		{"storage", "local"},
+		{"storage", "git"},
+	} {
+		_, ok := lookup(decoded, absent...)
+		assert.False(t, ok, "%v should be absent", absent)
+	}
+}
+
+func TestDefaultConfigDecodesDurations(t *testing.T) {
+	flush, ok := lookup(decodeConfig(t, DefaultConfig()), "audit", "buffer", "flush_period")
+
+	require.True(t, ok)
+	assert.Equal(t, 2*time.Minute, flush)
+}
+
+func TestDefaultConfigDecodesVersion(t *testing.T) {
+	decoded := decodeConfig(t, &Config{Version: "1.0"})
+
+	assert.Equal(t, "1.0", decoded["version"])
+}
+
+func TestFieldKey(t *testing.T) {
+	type tagged struct {
+		Omit   string `mapstructure:"flush_period,omitempty"`
+		Squash string `mapstructure:",squash"`
+		Plain  string `mapstructure:"plain"`
+		Bare   string
+	}
+
+	typ := reflect.TypeOf(tagged{})
+	want := []string{"flush_period", "", "plain", "bare"}
+	for i, w := range want {
+		assert.Equal(t, w, fieldKey(typ.Field(i)), typ.Field(i).Name)
+	}
+}
