+func TestStorageValidateNilPointers(t *testing.T) {
+	assert.EqualError(t, (&StorageConfig{Type: GitStorageType}).validate(), "git ref must be specified")
+	assert.EqualError(t, (&StorageConfig{Type: LocalStorageType}).validate(), "local path must be specified")
+}
