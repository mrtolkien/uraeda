+// validateAgainstSchema validates cfg against #FliptSpec, requiring every value to be concrete.
+func validateAgainstSchema(t *testing.T, cfg map[string]any) error {
+	t.Helper()
+
+	schema, err := os.ReadFile("../../config/flipt.schema.cue")
+	require.NoError(t, err)
+
+	ctx := cuecontext.New()
+	spec := ctx.CompileBytes(schema)
+	require.NoError(t, spec.Err())
+
+	def := spec.LookupPath(cue.ParsePath("#FliptSpec"))
+	require.NoError(t, def.Err())
+
+	return def.Unify(ctx.Encode(cfg)).Validate(cue.Concrete(true))
+}
+
+func TestSchema(t *testing.T) {
+	const dbURL = "postgres://postgres@localhost:5432/flipt"
+
+	tests := []struct {
+		name    string
+		cfg     map[string]any
+		wantErr bool
+	}{
+		{
+			name: "db fields without port or user",
+			cfg:  map[string]any{"db": map[string]any{"protocol": "postgres", "host": "localhost", "name": "flipt"}},
+		},
+		{
+			name:    "db url mixed with host",
+			cfg:     map[string]any{"db": map[string]any{"url": dbURL, "host": "localhost"}},
+			wantErr: true,
+		},
+		{
+			name:    "db fields without name",
+			cfg:     map[string]any{"db": map[string]any{"protocol": "postgres", "host": "localhost"}},
+			wantErr: true,
+		},
+		{
+			name: "db shared options with fields",
+			cfg: map[string]any{"db": map[string]any{
+				"protocol": "postgres", "host": "localhost", "name": "flipt",
+				"conn_max_lifetime": "30m0s", "prepared_statements_enabled": false,
