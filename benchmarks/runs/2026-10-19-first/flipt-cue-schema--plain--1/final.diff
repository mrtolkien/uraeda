+		Result:     &m,
+	})
+	require.NoError(t, err)
+	require.NoError(t, dec.Decode(DefaultConfig()))
+
+	adaptDurations(m)
+
+	b, err := os.ReadFile("../../config/flipt.schema.cue")
+	require.NoError(t, err)
+	cctx := cuecontext.New()
+	v := cctx.CompileBytes(b)
+	require.NoError(t, v.Err())
+	spec := v.LookupPath(cue.ParsePath("#FliptSpec"))
+	require.NoError(t, spec.Err())
+	err = spec.Unify(cctx.Encode(m)).Validate(cue.Concrete(true))
+	if err != nil {
+		t.Fatal(cueerrors.Details(err, nil))
+	}
+}
