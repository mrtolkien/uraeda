+func adaptDurations(v any) any {
+	switch t := v.(type) {
+	case map[string]any:
+		for k, e := range t {
+			t[k] = adaptDurations(e)
+		}
+	case []any:
+		for i, e := range t {
+			t[i] = adaptDurations(e)
+		}
+	case time.Duration:
+		return t.String()
+	}
+	return v
+}
