+    public getLengthTo(event: MatrixEvent): number {
+        let length = 0;
+
+        for (const current of this.events) {
+            if (current === event) break;
+            length += this.calculateChunkLength(current);
+        }
+
+        return length;
+    }
+
+    public findByTime(time: number): MatrixEvent | null {
+        let lengthSoFar = 0;
+
+        for (const event of this.events) {
+            lengthSoFar += this.calculateChunkLength(event);
+            if (lengthSoFar >= time) return event;
+        }
+
+        return null;
+    }
+
     public includes(event: MatrixEvent): boolean {
         return !!this.events.find(e => e.getId() === event.getId());
     }
