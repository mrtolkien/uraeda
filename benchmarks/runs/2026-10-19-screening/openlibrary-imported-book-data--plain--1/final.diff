+class LanguageMultipleMatchError(Exception):
+    """Exception raised when more than one possible language match is found."""
+
+    def __init__(self, language_name):
+        self.language_name = language_name
+        super().__init__(language_name)
+
+
+class LanguageNoMatchError(Exception):
+    """Exception raised when no matching languages are found."""
+
+    def __init__(self, language_name):
+        self.language_name = language_name
+        super().__init__(language_name)
+
+
+def get_abbrev_from_full_lang_name(input_lang_name: str, languages=None) -> str:
+    """
+    Return the three-character language code whose canonical or translated
+    name matches input_lang_name (case and accent insensitive).
+
+    :raises LanguageNoMatchError: if nothing matches
+    :raises LanguageMultipleMatchError: if more than one language matches
+    """
+    if languages is None:
+        languages = get_languages().values()
+
+    def normalize(s: str) -> str:
+        return strip_accents(s).lower()
+
+    target = normalize(input_lang_name)
+    matches = {}
+    for lang in languages:
+        names = [lang.name]
+        translated = getattr(lang, 'name_translated', None) or {}
+        for translations in translated.values():
+            names.extend(translations)
+        if any(normalize(n) == target for n in names if n):
+            matches[lang.code] = True
+
+    if not matches:
+        raise LanguageNoMatchError(input_lang_name)
+    if len(matches) > 1:
+        raise LanguageMultipleMatchError(input_lang_name)
+    return next(iter(matches))
+
+
