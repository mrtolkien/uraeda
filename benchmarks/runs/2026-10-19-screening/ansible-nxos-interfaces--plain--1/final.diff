+def default_intf_enabled(name='', sysdefs=None, mode=None):
+    """Get device/version/interface-specific default 'enabled' state.
+    L3:
+     - Most L3 interfaces default to 'shutdown'. Loopbacks default to
+       'no shutdown'. N3K/N5K/N6K platforms default to 'no shutdown'.
+    L2:
+     - Defaults are governed by 'system default switchport shutdown'.
+    """
+    if not name:
+        return None
+    sysdefs = sysdefs or {}
+    if re.match('port-channel|loopback', name, re.I):
+        return True
+
+    if get_interface_type(name) != 'ethernet':
+        return None
+
+    mode = mode or sysdefs.get('mode')
+    if mode == 'layer2':
+        return sysdefs.get('L2_enabled', True)
+    if mode == 'layer3':
+        return sysdefs.get('L3_enabled', False)
+    return None
+
