+    def render_system_defaults(self, config):
+        """Parse the user system defaults and platform family. Records the
+        device-wide default mode and default L2/L3 enabled states.
+        """
+        config = config or ''
+        mode = 'layer3'
+        if re.search(r'^system default switchport\s*$', config, re.M):
+            mode = 'layer2'
+        elif re.search(r'^no system default switchport\s*$', config, re.M):
+            mode = 'layer3'
+        l2_enabled = not re.search(r'^system default switchport shutdown\s*$', config, re.M)
+
+        info = self._device_info() or {}
+        platform = (info.get('network_os_platform') or '').upper()
+        match = re.match(r'(N[35679]K)', platform)
+        family = match.group(1) if match else ''
+        l3_enabled = family in ('N3K', 'N5K', 'N6K')
+
+        self.sysdefs = {
+            'mode': mode,
+            'L2_enabled': l2_enabled,
+            'L3_enabled': l3_enabled,
+        }
