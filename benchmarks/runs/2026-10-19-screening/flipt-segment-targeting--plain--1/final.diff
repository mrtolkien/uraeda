+
+// SegmentKey is a single segment key.
+type SegmentKey string
+
+func (SegmentKey) IsSegment() {}
+
+// Segments is a group of segment keys combined by an operator.
+type Segments struct {
+	Keys            []string `yaml:"keys,omitempty"`
+	SegmentOperator string   `yaml:"operator,omitempty"`
+}
+
+func (Segments) IsSegment() {}
+
+// SegmentEmbed wraps either a SegmentKey or Segments for (un)marshalling.
+type SegmentEmbed struct {
+	IsSegment `yaml:"-"`
+}
+
+// MarshalYAML emits a string for SegmentKey and an object for Segments.
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	switch t := s.IsSegment.(type) {
+	case SegmentKey:
+		return string(t), nil
+	case *SegmentKey:
+		return string(*t), nil
+	case Segments:
+		return t, nil
+	case *Segments:
+		return *t, nil
+	}
+
+	return nil, errors.New("failed to marshal to string or segments")
+}
+
+// UnmarshalYAML accepts either a string or a keys/operator object.
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var sk SegmentKey
+	if err := unmarshal(&sk); err == nil {
+		s.IsSegment = sk
+		return nil
+	}
+
+	var sks Segments
+	if err := unmarshal(&sks); err == nil {
+		s.IsSegment = sks
+		return nil
+	}
+
+	return errors.New("failed to unmarshal to string or segments")
 }
 
