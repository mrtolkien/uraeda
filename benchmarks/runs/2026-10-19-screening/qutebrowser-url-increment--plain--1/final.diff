+def _find_last_number(text):
+    """Find the last number in text, ignoring percent-encoded triplets.
+
+    Return:
+        A (pre, zeroes, number, post) tuple, or None.
+    """
+    for run in reversed(list(re.finditer(r'\d+', text))):
+        start, end = run.span()
+        if start >= 1 and text[start - 1] == '%':
+            start += 2
+        elif (start >= 2 and text[start - 2] == '%' and
+              text[start - 1] in 'abcdefABCDEF'):
+            start += 1
+        if start >= end:
+            continue
+        digits = text[start:end]
+        stripped = digits.lstrip('0')
+        zeroes = digits[:len(digits) - len(stripped)]
+        if not stripped:
+            # all zeroes: treat last zero as the number
+            zeroes, stripped = digits[:-1], digits[-1]
+        return text[:start], zeroes, stripped, text[end:]
+    return None
+
