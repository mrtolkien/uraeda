+from openlibrary.core.bookshelves import Bookshelves
+
+from . import db
+
+
+class Bestbook(db.CommonExtras):
+    """Best Book Awards operations."""
+
+    TABLENAME = "bestbooks"
+    PRIMARY_KEY = "award_id"
+    ALLOW_DELETE_ON_CONFLICT = False
+
+    class AwardConditionsError(Exception):
+        """Raised when award conditions are not met."""
+
+    @classmethod
+    def prepare_query(
+        cls,
+        select: str = "*",
+        work_id: str | None = None,
+        username: str | None = None,
+        topic: str | None = None,
+    ) -> tuple[str, dict]:
+        conditions = []
+        filters = {'work_id': work_id, 'username': username, 'topic': topic}
+        for key, value in filters.items():
+            if value is not None:
+                conditions.append(f"{key}=${key}")
+        query = f"SELECT {select} FROM {cls.TABLENAME}"
+        if conditions:
+            query += " WHERE " + " AND ".join(conditions)
+        return query, filters
+
+    @classmethod
+    def get_count(
+        cls,
+        work_id: str | None = None,
+        username: str | None = None,
+        topic: str | None = None,
+    ) -> int:
+        query, filters = cls.prepare_query(
+            select="count(*)", work_id=work_id, username=username, topic=topic
+        )
+        result = db.get_db().query(query, vars=filters)
+        return result[0]['count'] if result else 0
+
+    @classmethod
+    def get_awards(
+        cls,
+        work_id: str | None = None,
+        username: str | None = None,
+        topic: str | None = None,
+    ) -> list:
+        query, filters = cls.prepare_query(
+            work_id=work_id, username=username, topic=topic
+        )
+        return list(db.get_db().query(query, vars=filters))
+
+    @classmethod
+    def get_leaderboard(cls) -> list[dict]:
+        result = db.get_db().query(
+            "SELECT work_id, COUNT(*) AS count FROM "
+            f"{cls.TABLENAME} GROUP BY work_id ORDER BY count DESC"
+        )
+        return [dict(r) for r in result] if result else []
+
+    @classmethod
+    def add(
+        cls,
+        username: str,
+        work_id: str,
+        topic: str,
+        comment: str = "",
+        edition_id: int | None = None,
+    ) -> int | None:
+        """Adds an award if conditions are met, else raises AwardConditionsError."""
+        if not Bookshelves.user_has_read_work(username=username, work_id=work_id):
+            raise cls.AwardConditionsError(
+                "Only books which have been marked as read may be given awards"
+            )
+        if cls.get_awards(username=username, work_id=work_id):
+            raise cls.AwardConditionsError(
+                "A work can only be nominated once per patron"
+            )
+        if cls.get_awards(username=username, topic=topic):
+            raise cls.AwardConditionsError(
+                "A topic can only be used for one work per patron"
+            )
+        oldb = db.get_db()
+        return oldb.insert(
+            cls.TABLENAME,
+            username=username,
+            work_id=work_id,
+            edition_id=edition_id,
+            topic=topic,
+            comment=comment or "",
+        )
+
+    @classmethod
+    def remove(
+        cls,
+        username: str,
+        work_id: str | None = None,
+        topic: str | None = None,
+    ) -> int:
+        """Removes any award for the username where work_id or topic matches."""
+        if work_id is None and topic is None:
+            raise ValueError("work_id or topic is required")
+        conds = []
+        if work_id is not None:
+            conds.append("work_id=$work_id")
+        if topic is not None:
+            conds.append("topic=$topic")
+        return db.get_db().delete(
+            cls.TABLENAME,
+            where="username=$username AND (" + " OR ".join(conds) + ")",
+            vars={'username': username, 'work_id': work_id, 'topic': topic},
+        )
