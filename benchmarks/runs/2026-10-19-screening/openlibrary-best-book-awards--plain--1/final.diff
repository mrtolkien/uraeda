+class bestbook_award(delegate.page):
+    path = r"/works/OL(\d+)W/awards"
+    encoding = "json"
+
+    def POST(self, work_id):
+        """Add, update or remove a Best Book award for the current patron."""
+
+        def response(**kw):
+            return delegate.RawText(json.dumps(kw), content_type="application/json")
+
+        user = accounts.get_current_user()
+        if not user:
+            return response(errors="Authentication failed")
+
+        i = web.input(op="add", edition_key=None, topic="", comment="")
+        edition_id = (
+            int(extract_numeric_id_from_olid(i.edition_key)) if i.edition_key else None
+        )
+        username = user.key.split('/')[-1]
+
+        try:
+            if i.op in ("add", "update"):
+                award = Bestbook.add(
+                    username=username,
+                    work_id=work_id,
+                    topic=i.topic,
+                    comment=i.comment or "",
+                    edition_id=edition_id,
+                )
+                return response(success=True, award=award)
+            if i.op == "remove":
+                rows = Bestbook.remove(username, work_id=work_id)
+                return response(success=True, rows=rows)
+            return response(errors="Invalid operation")
+        except Bestbook.AwardConditionsError as e:
+            return response(errors=str(e))
+
+
+class bestbook_count(delegate.page):
+    path = "/awards/count"
+    encoding = "json"
+
+    def GET(self):
+        i = web.input(work_id=None, username=None, topic=None)
+        count = Bestbook.get_count(
+            work_id=i.work_id, username=i.username, topic=i.topic
+        )
+        return delegate.RawText(
+            json.dumps({"count": count}), content_type="application/json"
+        )
+
