+def prepare_multipart(fields):
+    """Takes a mapping, and prepares a multipart/form-data body
+
+    :arg fields: Mapping of field name to either a string, or a mapping with
+        ``filename``, ``content`` and ``mime_type`` keys
+    :returns: tuple of (content_type, body)
+    """
+    if not isinstance(fields, Mapping):
+        raise TypeError('Mapping is required, cannot be type %s' % fields.__class__.__name__)
+
+    boundary = '===============%d==' % random.randrange(sys.maxsize)
+    parts = []
+    for name, value in sorted(fields.items()):
+        if isinstance(value, string_types):
+            parts.append((False, b'text/plain', to_bytes(name), None, to_bytes(value)))
+            continue
+        if not isinstance(value, Mapping):
+            raise TypeError('Value must be a string or mapping, cannot be type %s' % value.__class__.__name__)
+
+        filename = value.get('filename')
+        content = value.get('content')
+        if not any((filename, content)):
+            raise ValueError('at least one of filename or content must be provided')
+
+        mime = value.get('mime_type')
+        if not mime:
+            try:
+                mime = mimetypes.guess_type(filename or '')[0] or 'application/octet-stream'
+            except Exception:
+                mime = 'application/octet-stream'
+
+        encoded = False
+        if content is None:
+            with open(to_bytes(filename, errors='surrogate_or_strict'), 'rb') as f:
+                content = f.read()
+            encoded = True
+        else:
+            content = to_bytes(content)
+        if filename:
+            filename = os.path.basename(filename)
+        parts.append((encoded, to_bytes(mime), to_bytes(name), filename, content))
+
+    bnd = to_bytes(boundary)
+    body = b''
+    for encoded, mime, name, filename, content in parts:
+        header = b''
+        if encoded:
+            header += b'Content-Transfer-Encoding: base64\r\n'
+            b64 = base64.b64encode(content)
+            lines = [b64[i:i + 76] for i in range(0, len(b64), 76)]
+            content = b'\r\n'.join(lines) + b'\r\n'
+        header += b'Content-Type: ' + mime + b'\r\n'
+        header += b'Content-Disposition: form-data; name="' + name + b'"'
+        if filename:
+            header += b'; filename="' + to_bytes(filename) + b'"'
+        body += b'--' + bnd + b'\r\n' + header + b'\r\n\r\n' + content + b'\r\n'
+    body += b'--' + bnd + b'--\r\n'
+
+    return 'multipart/form-data; boundary=%s' % boundary, body
+
