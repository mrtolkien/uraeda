{
  "name": "uraeda-binding",
  "version": "0.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrtolkien/uraeda.git",
    "directory": "packages/binding"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./test-utils": "./test-utils.ts"
  },
  "scripts": {
    "build": "napi build --platform --esm --no-const-enum --manifest-path ../../crates/binding/Cargo.toml --output-dir ."
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.8",
    "@types/node": "^24.19.1"
  },
  "napi": {
    "binaryName": "uraeda-binding",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  }
}
